<t-navbar title="团单数据看板" left-arrow />

<view class="data-center">
  <view class="card first">
    <view class="card-header">
      <view class="card-header__title">当前范围</view>
      <view class="card-header__desc">{{dataModeText}}</view>
    </view>
    <view class="card-content">
      <view class="card-content__item" wx:for="{{summaryList}}" wx:key="name">
        <view class="card-content__item--desc">{{item.name}}</view>
        <view class="card-content__item--count">{{item.number}}</view>
      </view>
    </view>
  </view>

  <view class="card forth">
    <view class="card-header">
      <view class="card-header__title">后续范围</view>
    </view>
    <view class="card-content">
      <t-empty icon="info-circle-filled" description="完整经营分析后续扩展；当前显示团单与客户订单汇总" />
    </view>
  </view>
</view>
