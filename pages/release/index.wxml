<sub-nav title="开团入口" fallback-url="/pages/my/index" />

<view class="page">
  <view class="release-container">
    <view class="box" wx:if="{{isNavigating}}">
      <t-cell title="正在打开开团表单" description="请稍候，系统正在进入团单编辑页。" />
    </view>
    <view class="box" wx:elif="{{canCreateGroupOrder}}">
      <button class="entry-button" bindtap="goCreateGroupOrder">
        <view class="entry-title">新建团单</view>
        <view class="entry-desc">进入团主开团表单，团单资料会按账号状态保存</view>
      </button>
    </view>
    <view class="box" wx:else>
      <t-cell title="开团入口" description="{{accessText}}" />
    </view>
  </view>
</view>
