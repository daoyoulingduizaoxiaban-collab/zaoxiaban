<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <view wx:if="{{disabledReason}}" class="mode-tip">{{disabledReason}}</view>
  <t-cell-group theme="card">
    <t-input label="导游/领队名称" placeholder="请输入导游/领队名称" value="{{ formData.title }}" data-field="title" bind:change="onInputChange" />
    <t-input label="城市" placeholder="请输入城市" value="{{ formData.city }}" data-field="city" bind:change="onInputChange" />
    <t-input label="手机号" placeholder="请输入手机号" value="{{ formData.phone }}" data-field="phone" bind:change="onInputChange" />
    <t-cell title="维护日期" note="{{ formData.date || '请选择' }}" arrow bind:tap="showDatePicker" />
    <t-input label="导游/领队状态" value="{{ formData.statusText }}" data-field="statusText" bind:change="onInputChange" />
  </t-cell-group>

  <view class="submit-bar" wx:if="{{canSave}}">
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bind:tap="onSave">保存导游/领队</t-button>
  </view>
</view>
