<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <t-cell-group theme="card">
    <t-input label="导游/领队名称" placeholder="请输入导游/领队名称" value="{{ formData.title }}" />
    <t-cell title="维护日期" note="{{ formData.date || '请选择' }}" arrow bind:tap="showDatePicker" />
    <t-input label="导游/领队状态" value="{{ formData.statusText }}" disabled />
  </t-cell-group>

  <view class="submit-bar">
    <t-button theme="primary" size="large" block bind:tap="onSave">保存导游/领队</t-button>
  </view>
</view>
