<nav nav-type="my" titleText="{{titleText}}" />

<view class="tourGuides-container">
  <page-state
    state="{{pageState}}"
    loading-text="正在加载团主资料"
    error-text="{{stateText}}"
    empty-text="{{stateText}}"
    bind:retry="loadTourGuides"
  >
    <view class="native-list">
      <view
        wx:for="{{tourGuidesList}}"
        wx:key="id"
        class="native-row"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="native-avatar">团</view>
        <view class="native-main">
          <view class="native-title">{{item.title}}</view>
          <view class="native-desc">{{item.description}}</view>
        </view>
        <view class="native-note">{{item.statusText}}</view>
      </view>
    </view>
  </page-state>

  <button wx:if="{{canCreateTourGuide}}" class="floating-action" bindtap="onGoToEdit">新增团主</button>
  <view wx:elif="{{canEditOwnTourGuide}}" class="own-edit">
    <button class="primary-action" bindtap="onGoToEdit">编辑我的团主资料</button>
  </view>

</view>
