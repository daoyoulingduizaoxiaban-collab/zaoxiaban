<nav nav-type="my" titleText="{{titleText}}" />

<view class="tourGuides-container">
  <t-cell-group theme="card">
    <block wx:for="{{ tourGuidesList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="{{ item.description }}" hover arrow
        bind:tap="goToDetail" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
        <t-icon slot="left-icon" name="user" size="48rpx" color="#0052d9" />
      </t-cell>
    </block>
  </t-cell-group>

  <view wx:if="{{ tourGuidesList.length === 0 }}" class="empty-state">
    <t-empty icon="info-circle" description="{{disabledReason || '暂无团主资料'}}" />
  </view>

  <t-fab wx:if="{{canCreateTourGuide}}" icon="add" bind:click="onGoToEdit" bind:tap="onGoToEdit" aria-label="新增团主" style="right: 32rpx; bottom: 180rpx;" />
  <view wx:elif="{{canEditOwnTourGuide}}" class="own-edit">
    <t-button theme="primary" size="large" block bind:tap="onGoToEdit">编辑我的团主资料</t-button>
  </view>

</view>
