<nav nav-type="home" titleText="{{titleText}}" />

<view class="home-container">
  <view class="home-content">
    <view class="access-card" wx:if="{{!authReady || isAccessLoading}}">
      <view class="access-title">正在确认账号状态</view>
      <view class="access-desc">请稍候，系统正在读取你的微信登录与业务权限。</view>
    </view>

    <view class="access-card" wx:elif="{{!canUseBusiness}}">
      <view class="access-title">{{accessStateText}}</view>
      <view class="access-desc">通过管理员确认后，会开放与你身份对应的团单、商品库、客户订单和数据入口。</view>
      <view class="access-actions">
        <t-button wx:if="{{accessState === 'logged_out'}}" theme="primary" size="small" bind:tap="goLogin">微信登录</t-button>
        <t-button wx:else theme="primary" size="small" bind:tap="refreshAccessState">重新检查状态</t-button>
      </view>
    </view>

    <view class="summary-band" wx:if="{{canUseBusiness}}">
      <view>
        <view class="summary-title">今日团单工作台</view>
        <view class="summary-desc">开团、选品、客户订单和收款核对集中处理</view>
      </view>
      <t-button wx:if="{{canCreateGroupOrder}}" theme="primary" size="small" bind:tap="goRelease">开团</t-button>
    </view>

    <view class="home-summary" wx:if="{{canUseBusiness}}">
      <view class="home-summary__card" wx:for="{{summaryCards}}" wx:key="label" bindtap="goSummaryCard" data-target="{{item.target}}">
        <view class="home-summary__label">{{item.label}}</view>
        <view class="home-summary__value">{{isSummaryLoading ? '...' : item.value}}</view>
      </view>
    </view>

    <view class="quick-grid" wx:if="{{canUseBusiness}}">
      <view class="quick-item primary" wx:if="{{canViewGroupOrders}}" bindtap="goGroupOrders">
        <t-icon name="bulletpoint" size="48rpx" color="#0052d9" />
        <view class="quick-title">团单</view>
        <view class="quick-desc">管理本团商品与客户入口</view>
      </view>
      <view class="quick-item" wx:if="{{canViewProducts}}" bindtap="goProducts">
        <t-icon name="shop" size="48rpx" color="#0052d9" />
        <view class="quick-title">商品库</view>
        <view class="quick-desc">维护可售商品与价格规则</view>
      </view>
      <view class="quick-item" wx:if="{{canViewCustomerOrders}}" bindtap="goCustomerOrders">
        <t-icon name="usergroup" size="48rpx" color="#0052d9" />
        <view class="quick-title">客户订单</view>
        <view class="quick-desc">处理付款声明和确认收款</view>
      </view>
      <view class="quick-item" wx:if="{{canViewDataCenter}}" bindtap="goDataCenter">
        <t-icon name="bulletpoint" size="48rpx" color="#0052d9" />
        <view class="quick-title">数据看板</view>
        <view class="quick-desc">查看团单与订单汇总</view>
      </view>
      <view class="quick-item" wx:if="{{canApplyProvider}}" bindtap="goProviderApply">
        <t-icon name="shop" size="48rpx" color="#0052d9" />
        <view class="quick-title">申请供应商</view>
        <view class="quick-desc">提交供货资料等待审核</view>
      </view>
      <view class="quick-item" wx:if="{{canViewOperationLogs}}" bindtap="goOperationLogs">
        <t-icon name="time" size="48rpx" color="#0052d9" />
        <view class="quick-title">操作记录</view>
        <view class="quick-desc">回看开团、商品与收款操作</view>
      </view>
    </view>

    <view class="status-note">
      {{modeText}}
    </view>

    <view class="home-actions">
      <t-button theme="default" variant="outline" size="small" bind:tap="goMy">返回我的</t-button>
    </view>
  </view>
</view>
