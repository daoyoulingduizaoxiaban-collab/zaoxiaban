<sub-nav title="{{ pageTitle }}" />

<view class="customer-edit">
  <view wx:if="{{!canSave}}" class="empty-state">
    <t-empty icon="info-circle" description="{{disabledReason}}" />
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <view wx:elif="{{pageErrorText}}" class="empty-state">
    <t-empty icon="info-circle" description="{{pageErrorText}}" />
  </view>

  <t-cell-group wx:else theme="card">
    <t-input label="客户姓名" placeholder="请输入客户姓名" value="{{formData.name}}" data-field="name" bind:change="onInputChange" />
    <t-input label="手机号" placeholder="请输入 11 位手机号" value="{{formData.phone}}" data-field="phone" bind:change="onInputChange" />
    <t-input label="城市" placeholder="请输入所在城市" value="{{formData.city}}" data-field="city" bind:change="onInputChange" />
    <t-input label="备注" placeholder="常用取货需求或联络说明" value="{{formData.introduction}}" data-field="introduction" bind:change="onInputChange" />
  </t-cell-group>

  <view class="submit-bar" wx:if="{{canSave && !pageErrorText}}">
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bind:tap="onSave">保存客户资料</t-button>
  </view>
</view>
