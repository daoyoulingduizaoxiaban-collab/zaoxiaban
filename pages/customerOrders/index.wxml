<nav nav-type="customerOrders" titleText="{{titleText}}" />

<view class="customerOrders-container">
  <t-cell-group theme="card">
    <block wx:for="{{ customerOrdersList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="客户：{{ item.customerName }}｜金额：￥{{ item.totalPrice }}" hover arrow
        bind:tap="goToDetail" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
        <t-icon slot="left-icon" name="usergroup" size="48rpx" color="#0052d9" />
      </t-cell>
    </block>
  </t-cell-group>

  <view wx:if="{{ customerOrdersList.length === 0 }}" class="empty-state">
    <t-empty icon="info-circle" description="暂无客户订单" />
  </view>

  <t-fab icon="add" bind:click="onGoToEdit" bind:tap="onGoToEdit" aria-label="新增客户订单" style="right: 32rpx; bottom: 180rpx;" />

</view>
