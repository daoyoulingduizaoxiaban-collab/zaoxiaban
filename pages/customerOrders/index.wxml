<nav nav-type="customerOrders" titleText="{{titleText}}" />

<view class="role-scope">{{roleScopeText}}</view>
<view class="save-mode" wx:if="{{saveModeText}}">{{saveModeText}}</view>

<view class="customerOrders-container">
  <view class="access-card" wx:if="{{!canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">通过管理员确认身份后，可查看与你相关的客户订单。</view>
    <t-button wx:if="{{!isLoggedIn}}" t-class="empty-login" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <view class="order-filter" wx:if="{{canUseBusiness}}">
    <t-dropdown-menu>
      <t-dropdown-item options="{{statusOptions}}" value="{{currentStatus}}" bind:change="onStatusChange" />
    </t-dropdown-menu>
  </view>

  <view wx:if="{{canUseBusiness && isLoading}}" class="empty-state">
    <t-empty icon="info-circle" description="正在加载客户订单" />
  </view>

  <view wx:elif="{{canUseBusiness && loadErrorText}}" class="empty-state">
    <t-empty icon="info-circle" description="{{loadErrorText}}" />
  </view>

  <t-cell-group theme="card" wx:elif="{{canUseBusiness}}">
    <block wx:for="{{ customerOrdersList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="客户：{{ item.customerName }}｜金额：￥{{ item.totalPrice }}" hover arrow="{{false}}"
        bind:tap="goToDetail" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
        <t-icon slot="left-icon" name="usergroup" size="48rpx" color="#0052d9" />
      </t-cell>
      <view class="order-actions">
        <text class="order-meta">商品 {{item.itemCount || 0}} 件｜状态记录 {{item.historyCount || 0}} 条</text>
        <t-button wx:if="{{item.paymentProofUrls.length}}" size="small" variant="outline" theme="default" bind:tap="previewOrderPaymentProof" data-id="{{item.id}}">查看凭证</t-button>
        <t-button wx:if="{{item.canHandle}}" size="small" variant="outline" theme="primary" bind:tap="onOrderAction" data-id="{{item.id}}">处理订单</t-button>
      </view>
    </block>
  </t-cell-group>

  <view wx:if="{{canUseBusiness && !isLoading && !loadErrorText && customerOrdersList.length === 0 }}" class="empty-state">
    <t-empty icon="info-circle" description="暂无客户订单" />
    <t-button wx:if="{{!isLoggedIn}}" t-class="empty-login" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <t-fab wx:if="{{canCreateCustomerOrder}}" icon="add" bind:click="onGoToEdit" bind:tap="onGoToEdit" aria-label="客户下单" style="right: 32rpx; bottom: 180rpx;" />

</view>

<view wx:if="{{actionPanelVisible}}" class="action-mask" catchtap="closeActionPanel">
  <view class="action-panel" catchtap="stopPanelTap">
    <view class="action-panel__header">
      <text class="action-panel__title">{{actionPanelTitle}}</text>
      <text class="action-panel__close" bind:tap="closeActionPanel">关闭</text>
    </view>

    <view wx:if="{{actionType === 'declarePaid'}}" class="action-form">
      <view class="action-field">
        <text class="action-label">付款金额</text>
        <input class="action-input" type="digit" placeholder="请输入实际付款金额" value="{{actionForm.declaredAmount}}" data-field="declaredAmount" bindinput="onActionInput" />
      </view>
      <view class="action-field">
        <text class="action-label">付款方式</text>
        <input class="action-input" placeholder="微信/支付宝/现金/转账" value="{{actionForm.paymentMethod}}" data-field="paymentMethod" bindinput="onActionInput" />
      </view>
      <view class="action-field">
        <text class="action-label">付款备注</text>
        <textarea class="action-textarea" placeholder="填写流水尾号、代付人或其他核对信息" value="{{actionForm.paymentRemark}}" data-field="paymentRemark" bindinput="onActionInput" />
      </view>
      <view class="action-proof">
        <view class="action-proof__header">
          <text class="action-label">付款凭证</text>
          <button size="mini" plain bindtap="chooseActionPaymentProof" disabled="{{isSubmittingAction}}">上传</button>
        </view>
        <view class="action-proof__list" wx:if="{{actionForm.paymentProofUrls.length}}">
          <view class="action-proof__item" wx:for="{{actionForm.paymentProofUrls}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" bindtap="previewActionPaymentProof" data-index="{{index}}" />
            <text bindtap="removeActionPaymentProof" data-index="{{index}}">移除</text>
          </view>
        </view>
      </view>
      <view class="action-hint">请填写付款金额、付款方式；可上传付款凭证，方便团主核对收款。</view>
    </view>

    <view wx:elif="{{actionType === 'confirmPayment'}}" class="action-form">
      <view class="action-field">
        <text class="action-label">实收金额</text>
        <input class="action-input" type="digit" placeholder="请输入实际到账金额" value="{{actionForm.confirmedAmount}}" data-field="confirmedAmount" bindinput="onActionInput" />
      </view>
      <view class="action-field">
        <text class="action-label">确认备注</text>
        <textarea class="action-textarea" placeholder="例：已核对微信到账，少付/多付说明" value="{{actionForm.confirmRemark}}" data-field="confirmRemark" bindinput="onActionInput" />
      </view>
    </view>

    <view wx:else class="action-form">
      <view class="action-field">
        <text class="action-label">取消原因</text>
        <textarea class="action-textarea" placeholder="选填，方便持续追踪" value="{{actionForm.cancelRemark}}" data-field="cancelRemark" bindinput="onActionInput" />
      </view>
    </view>

    <view class="action-panel__footer">
      <t-button size="large" variant="outline" bind:tap="closeActionPanel" disabled="{{isSubmittingAction}}">取消</t-button>
      <t-button size="large" theme="primary" loading="{{isSubmittingAction}}" bind:tap="submitActionPanel">{{actionSubmitText}}</t-button>
    </view>
  </view>
</view>
