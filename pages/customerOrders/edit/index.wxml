<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <t-cell-group theme="card">
    <t-input label="客户订单名称" placeholder="请输入客户订单名称" value="{{ formData.title }}" />
    <t-cell title="下单日期" note="{{ formData.date || '请选择' }}" arrow bind:tap="showDatePicker" />
    <t-input label="客户订单状态" value="{{ formData.statusText }}" disabled />
  </t-cell-group>

  <view class="submit-bar">
    <t-button theme="primary" size="large" block bind:tap="onSave">保存客户订单</t-button>
  </view>
</view>
