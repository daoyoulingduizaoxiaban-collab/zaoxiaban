<sub-nav title="{{ pageTitle }}" />

<view class="access-card" wx:if="{{accessDenied}}">
  <view class="access-title">{{accessStateText || '当前账号不能提交客户订单'}}</view>
  <view class="access-desc">请使用已通过审核的客户账号，或从有效团单入口进入。</view>
  <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bind:tap="onLogin">去登录</t-button>
</view>

<view class="edit-container" wx:else>
  <view class="mode-tip">{{saveModeText}}</view>

  <view wx:if="{{isLoading}}" class="empty-state">
    正在加载团单
  </view>

  <view wx:elif="{{pageErrorText}}" class="empty-state">
    {{pageErrorText}}
  </view>

  <view wx:elif="{{groupOrder}}" class="group-card">
    <view class="group-title">{{groupOrder.title}}</view>
    <view class="group-desc">{{groupOrder.description}}</view>
    <view class="group-status">收单状态：{{groupOrder.statusText}}</view>
    <view class="group-meta">出团/活动：{{groupOrder.startAt || '未填写'}}</view>
    <view class="group-meta">收单截止：{{groupOrder.endAt || '未填写'}}</view>
    <view class="group-meta">取货/集合：{{groupOrder.pickupNote || '未填写'}}</view>
    <view class="group-meta">付款说明：{{groupOrder.paymentNote || '未填写'}}</view>
    <view class="group-meta">联系人：{{groupOrder.contactName || '未填写'}} {{groupOrder.contactPhone || ''}}</view>
    <view class="group-meta" wx:if="{{groupOrder.customerNotice}}">提示：{{groupOrder.customerNotice}}</view>
  </view>

  <view wx:else class="empty-state">
    未找到可下单团单
  </view>

  <t-cell-group theme="card" wx:if="{{groupOrder && !pageErrorText}}">
    <t-input label="客户姓名" placeholder="请输入客户姓名" value="{{ formData.customerName }}" data-field="customerName" bind:change="onInputChange" />
    <t-input label="手机号" placeholder="请输入 11 位手机号" value="{{ formData.customerPhone }}" data-field="customerPhone" bind:change="onInputChange" />
    <t-input label="备注" placeholder="取货时间、特殊需求等" value="{{ formData.memberRemark }}" data-field="memberRemark" bind:change="onInputChange" />
    <t-input label="付款方式" placeholder="微信/支付宝/现金/转账" value="{{ formData.paymentMethod }}" data-field="paymentMethod" bind:change="onInputChange" />
    <t-input label="付款备注" placeholder="付款姓名、流水尾号或其他说明" value="{{ formData.paymentRemark }}" data-field="paymentRemark" bind:change="onInputChange" />
    <view class="proof-section">
      <view class="proof-header">
        <text>付款凭证</text>
        <button size="mini" plain bindtap="choosePaymentProof">上传</button>
      </view>
      <view class="proof-list" wx:if="{{formData.paymentProofUrls.length}}">
        <view class="proof-item" wx:for="{{formData.paymentProofUrls}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" bindtap="previewPaymentProof" data-index="{{index}}" />
          <text bindtap="removePaymentProof" data-index="{{index}}">移除</text>
        </view>
      </view>
    </view>
  </t-cell-group>

  <view wx:if="{{groupOrder && !pageErrorText}}" class="section-title">选择本团商品</view>

  <block wx:if="{{groupOrder && !pageErrorText}}" wx:for="{{productRows}}" wx:key="id">
    <view class="product-card">
      <view class="product-image-wrap">
        <image wx:if="{{item.coverUrl && !item.isImageFallback}}" class="product-image" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onProductImageError" />
        <text wx:if="{{item.isImageFallback}}" class="product-image-fallback">{{item.imageFallbackText || '暂无商品图片'}}</text>
      </view>
      <view class="product-main">
        <view class="product-title">{{item.title}}</view>
        <view class="product-desc">{{item.description}}</view>
        <view class="product-price">{{item.priceDisplay}}</view>
        <view class="rule-text">{{item.selectedRuleText || '输入数量后自动匹配阶梯价格'}}</view>
      </view>
      <view class="quantity-box">
        <input class="quantity-input" type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindinput="onQuantityInput" />
        <text class="quantity-label">件</text>
      </view>
      <view class="line-total">￥{{item.lineTotal || 0}}</view>
    </view>
  </block>

  <view wx:if="{{groupOrder && !pageErrorText && productRows.length === 0}}" class="empty-state">
    当前团单暂无可下单商品
  </view>

  <view class="submit-bar" wx:if="{{groupOrder && !pageErrorText}}">
    <view class="total-row">
      <text>合计</text>
      <text class="total-price">￥{{totalPrice}}</text>
    </view>
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting || productRows.length === 0}}" bind:tap="onSave">
      提交客户订单
    </t-button>
  </view>
</view>
