<t-toast id="t-toast" />

<view class="my">
  <nav title-text="我的" />
  <view class="my-info">
    <t-cell-group>
      <t-cell wx:if="{{isLoad && canUseBusiness}}" bordered="{{false}}">
        <t-avatar image="{{personalInfo.image}}" slot="left-icon" size="large" />
        <view class="my-info__person" slot="description">
          <view class="name">
            {{personalInfo.name}}
            <text class="copy-id" catchtap="onCopyOpenId">复制ID</text>
          </view>
          <view class="tags">
            <t-tag class="tag" variant="light">{{personalInfo.star}}</t-tag>
            <t-tag class="tag" variant="light">{{personalInfo.authSourceText}}</t-tag>
          </view>
        </view>
        <t-icon slot="right-icon" name="edit" size="40rpx" color="#000000e6" bindtap="onNavigateTo" />
      </t-cell>
      <view wx:if="{{!isLoggedIn}}" class="login-card-entry" catchtap="onLogin" bindtouchend="onLoginTouchEnd">
        <t-avatar image="/static/avatar1.png" size="128rpx" />
        <view class="login-card-entry__text">
          <view class="login-card-entry__title">请先登录/注册</view>
          <view class="login-card-entry__desc">登录后继续</view>
        </view>
      </view>
    </t-cell-group>
    <view class="auth-warning" wx:if="{{canShowDeviceOnlyNotice}}">
      当前账号资料已载入。
    </view>
    <view class="auth-warning auth-warning--preview" wx:if="{{canShowRolePreviewNotice}}">
      真实身份：{{realRoleText}}｜当前预览：{{previewRoleText}}
    </view>
    <view class="access-card" wx:if="{{isLoggedIn && !canUseBusiness}}">
      <view class="access-title">{{accessStateText}}</view>
      <view class="access-desc">{{accessStateDesc}}</view>
      <t-button theme="primary" variant="outline" size="small" bindtap="onRefreshAccessState">重新检查状态</t-button>
      <t-button theme="default" variant="outline" size="small" bindtap="onContactAdmin">联系管理员</t-button>
    </view>
    <view class="auth-actions" wx:if="{{!isLoggedIn}}">
      <button class="login-action-native" catchtap="onLogin" bindtouchend="onLoginTouchEnd">登录后继续</button>
    </view>
    <t-divider wx:if="{{canUseBusiness}}" t-class="divider-class" />
    <view class="service-grid" wx:if="{{canUseBusiness}}">
      <button
        wx:for="{{gridList}}"
        wx:for-item="gridItem"
        wx:key="type"
        class="service-grid__item {{gridItem.type === 'all' ? 'split-line' : ''}}"
        hover-class="service-grid__item--hover"
        data-data="{{gridItem}}"
        data-name="{{gridItem.name}}"
        data-type="{{gridItem.type}}"
        data-url="{{gridItem.url}}"
        catchtap="onEleClick"
      >
        <t-icon
          name="{{gridItem.icon}}"
          size="48rpx"
          color="#0052d9"
        />
        <text class="service-grid__text">{{gridItem.name}}</text>
      </button>
    </view>
  </view>

  <view wx:if="{{isLoggedIn && settingList.length}}" class="setting-card">
    <button
      wx:for="{{settingList}}"
      wx:for-item="item"
      wx:key="type"
      class="setting-row"
      hover-class="setting-row--hover"
      data-data="{{item}}"
      data-name="{{item.name}}"
      data-type="{{item.type}}"
      data-url="{{item.url}}"
      bindtap="onEleClick"
    >
      <text class="setting-row__icon">{{item.iconText}}</text>
      <text class="setting-row__title">{{item.name}}</text>
    </button>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-bar">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
