<t-toast id="t-toast" />

<view class="my">
  <nav title-text="我的" />
  <view class="my-info">
    <t-cell-group>
      <t-cell wx:if="{{isLoad && canUseBusiness}}" bordered="{{false}}">
        <t-avatar image="{{personalInfo.image}}" slot="left-icon" size="large" />
        <view class="my-info__person" slot="description">
          <view class="name">{{personalInfo.name}}</view>
          <view class="tags">
            <t-tag class="tag" variant="light" icon="discount">{{personalInfo.star}}</t-tag>
            <t-tag class="tag" variant="light" icon="location">{{personalInfo.city}}</t-tag>
            <t-tag class="tag" variant="light" icon="secured">{{personalInfo.authSourceText}}</t-tag>
          </view>
        </view>
        <t-icon slot="right-icon" name="edit" size="40rpx" color="#000000e6" bindtap="onNavigateTo" />
      </t-cell>
      <view wx:if="{{!isLoggedIn}}" class="login-card-entry" catchtap="onLogin" bindtouchend="onLoginTouchEnd">
        <t-avatar icon="user" size="128rpx" />
        <view class="login-card-entry__text">
          <view class="login-card-entry__title">请先登录/注册</view>
          <view class="login-card-entry__desc">登录后继续</view>
        </view>
      </view>
    </t-cell-group>
    <view class="auth-warning" wx:if="{{authSession.isMockOpenId && !authSession.qaOverride}}">
      当前为演示身份，资料仅保留在当前设备。
    </view>
    <view class="auth-warning auth-warning--qa" wx:if="{{authSession.qaOverride}}">
      当前为演示身份切换，仅用于预览角色可见范围。
    </view>
    <view class="access-card" wx:if="{{isLoggedIn && !canUseBusiness}}">
      <view class="access-title">{{accessStateText}}</view>
      <view class="access-desc">管理员确认身份后，会开放与你角色对应的正式功能。</view>
      <t-button theme="primary" variant="outline" size="small" bindtap="onRefreshAccessState">重新检查状态</t-button>
      <t-button theme="default" variant="outline" size="small" bindtap="onContactAdmin">联系管理员</t-button>
    </view>
    <view class="auth-actions" wx:if="{{isLoggedIn}}">
      <t-button theme="default" variant="outline" size="small" bindtap="onLogout">退出登录</t-button>
    </view>
    <view class="auth-actions" wx:else>
      <button class="login-action-native" catchtap="onLogin" bindtouchend="onLoginTouchEnd">登录后继续</button>
    </view>
    <t-divider wx:if="{{canUseBusiness}}" t-class="divider-class" />
    <t-grid t-class="grid-class" wx:if="{{canUseBusiness}}">
      <t-grid-item
        wx:for="{{gridList}}"
        wx:for-item="gridItem"
        wx:key="type"
        text="{{gridItem.name}}"
        icon="{{gridItem.icon}}"
        class="grid-item {{gridItem.type === 'all' ? 'split-line' : ''}}"
        data-data="{{gridItem}}"
        bindclick="onEleClick"
      />
    </t-grid>
  </view>

  <t-cell-group wx:if="{{canUseBusiness}}" theme="card">
    <t-cell
      wx:for="{{settingList}}"
      wx:for-item="item"
      wx:key="type"
      title="{{item.name}}"
      url="{{item.url}}"
      leftIcon="{{item.icon}}"
      hover
      arrow
      data-data="{{item}}"
      bindclick="onEleClick"
    />
  </t-cell-group>
</view>
