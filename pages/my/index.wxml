<t-toast id="t-toast" />

<view class="my">
  <nav title-text="我的" />
  <view class="my-info">
    <t-cell-group>
      <t-cell wx:if="{{isLoad}}" bordered="{{false}}">
        <t-avatar image="{{personalInfo.image}}" slot="left-icon" size="large" />
        <view class="my-info__person" slot="description">
          <view class="name">{{personalInfo.name}}</view>
          <view class="tags">
            <t-tag class="tag" variant="light" icon="discount">{{personalInfo.star}}</t-tag>
            <t-tag class="tag" variant="light" icon="location">{{personalInfo.city}}</t-tag>
            <t-tag class="tag" variant="light" icon="secured">{{personalInfo.authSourceText}}</t-tag>
          </view>
        </view>
        <t-icon slot="right-icon" name="edit" size="40rpx" color="#000000e6" bindtap="onNavigateTo" />
      </t-cell>
      <t-cell
        wx:if="{{!isLoad}}"
        title="请先登录/注册"
        bordered="{{false}}"
        t-class-title="cell-class-title"
        t-class-center="cell-class-center"
        bindtap="onLogin"
      >
        <t-avatar slot="left-icon" icon="user" size="128rpx" />
      </t-cell>
    </t-cell-group>
    <view class="auth-warning" wx:if="{{authSession.isMockOpenId && !authSession.qaOverride}}">
      当前为演示身份，资料仅保留在当前设备。
    </view>
    <view class="auth-warning auth-warning--qa" wx:if="{{authSession.qaOverride}}">
      当前为演示身份切换，仅用于预览角色可见范围。
    </view>
    <view class="auth-actions" wx:if="{{isLoggedIn}}">
      <t-button theme="default" variant="outline" size="small" bindtap="onLogout">退出登录</t-button>
    </view>
    <t-divider t-class="divider-class" />
    <t-grid t-class="grid-class">
      <t-grid-item
        wx:for="{{gridList}}"
        wx:for-item="gridItem"
        wx:key="type"
        text="{{gridItem.name}}"
        icon="{{gridItem.icon}}"
        class="grid-item {{gridItem.type === 'all' ? 'split-line' : ''}}"
        data-data="{{gridItem}}"
        bindclick="onEleClick"
      />
    </t-grid>
  </view>

  <view class="qa-panel" wx:if="{{canShowQaTools}}">
    <view class="qa-panel__title">演示资料工具</view>
    <view class="qa-panel__meta">
      <text>用户 {{qaSeedInfo.userCount}}</text>
      <text>团单 {{qaSeedInfo.groupOrderCount}}</text>
      <text>商品 {{qaSeedInfo.productCount}}</text>
      <text>客户订单 {{qaSeedInfo.customerOrderCount}}</text>
    </view>
    <view class="qa-panel__role-title">演示身份切换</view>
    <view class="qa-panel__roles">
      <t-button
        wx:for="{{qaRoleOptions}}"
        wx:key="value"
        theme="default"
        variant="outline"
        size="small"
        data-role="{{item.value}}"
        bindtap="onQaRoleSwitch"
      >
        {{item.label}}
      </t-button>
    </view>
    <view class="qa-panel__role-title">订单隔离验证</view>
    <view class="qa-panel__checks">
      <t-button
        wx:for="{{qaIsolationActions}}"
        wx:key="role"
        theme="primary"
        variant="outline"
        size="small"
        data-role="{{item.role}}"
        bindtap="onQaIsolationCheck"
      >
        {{item.label}}
      </t-button>
    </view>
    <t-button theme="primary" size="large" block bindtap="onResetQaSeed">
      一键重置演示资料
    </t-button>
  </view>

  <view class="my-service" wx:if="{{canShowQaTools}}">
    <view class="my-service--tips">演示工具</view>
    <t-grid column="{{4}}" class="my-service__list">
      <t-grid-item
        class="my-service__list-item"
        wx:for="{{service}}"
        wx:key="item"
        text="{{item.name}}"
        image="{{item.image}}"
        url="{{item.url}}"
        data-data="{{item}}"
        bindclick="onEleClick"
      />
    </t-grid>
  </view>

  <t-cell-group theme="card">
    <t-cell
      wx:for="{{settingList}}"
      wx:for-item="item"
      wx:key="type"
      title="{{item.name}}"
      url="{{item.url}}"
      leftIcon="{{item.icon}}"
      hover
      arrow
      data-data="{{item}}"
      bindclick="onEleClick"
    />
  </t-cell-group>
</view>
