.feedback-page {
  padding: 32rpx;
}

.tip {
  font-size: 24rpx;
  color: #8a94a6;
  line-height: 36rpx;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.req {
  color: #ff4d4f;
  margin-left: 6rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 16rpx;
  background: #0052d9;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
