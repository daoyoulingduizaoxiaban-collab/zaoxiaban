<sub-nav title="设置" fallback-url="/pages/my/index" />
<view class="setting">
  <view class="setting-login" wx:if="{{!isLoggedIn}}">
    <view class="setting-login__title">登录后查看账号与资料保存状态</view>
    <t-button theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>
  <t-cell-group wx:if="{{isLoggedIn}}" wx:for="{{menuData}}" wx:for-item="item" wx:key="index" t-class="cell-group-class" theme="card">
    <t-cell
      wx:for="{{item}}"
      wx:for-item="carditem"
      wx:key="title"
      title="{{carditem.title}}"
      note="{{carditem.note}}"
      hover
      arrow="{{false}}"
      url="{{carditem.url}}"
      bordered="true"
      data-data="{{carditem}}"
      bindclick="onEleClick"
    >
      <t-icon slot="left-icon" name="{{carditem.icon}}" size="44rpx" color="#0052d9" />
    </t-cell>
  </t-cell-group>

  <!-- 账号资料直接在本页编辑，跟「当前角色」同页，不再另开一页。 -->
  <view wx:if="{{isLoggedIn && canEditInfo}}" class="info-field-card">
    <view class="field-row">
      <text class="field-label">用户名</text>
      <input class="field-input" type="nickname" value="{{personInfo.name}}" placeholder="点此填写/带出微信昵称" bindinput="onNameChange" bindblur="onNameChange" />
    </view>
    <view class="field-row">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" value="{{personInfo.phone}}" placeholder="请输入 11 位手机号" bindinput="onPhoneChange" />
    </view>
    <view class="field-row field-row--block">
      <text class="field-label">性别</text>
      <radio-group class="gender-group" bindchange="onGenderChange">
        <label wx:for="{{genderOptions}}" wx:key="value" class="gender-option">
          <radio value="{{item.value}}" checked="{{personInfo.gender === item.value}}" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>
    <view class="field-row field-row--block">
      <text class="field-label">个人简介</text>
      <textarea class="field-textarea" value="{{personInfo.introduction}}" placeholder="请输入个人简介" maxlength="50" bindinput="onIntroductionChange" />
    </view>
    <view class="field-row field-row--block">
      <t-button theme="primary" block loading="{{isSubmittingInfo}}" disabled="{{isSubmittingInfo}}" bindtap="onSaveInfo">保存账号资料</t-button>
    </view>
  </view>
  <view wx:elif="{{isLoggedIn && infoDisabledReason}}" class="info-field-disabled">{{infoDisabledReason}}</view>
</view>

<t-toast id="t-toast" />
