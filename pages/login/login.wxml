<t-navbar left-arrow />
<view class="page login">
  <view class="login__title">登录导游领队早下班</view>
  <view class="login__subtitle">用于开团、团单、商品库和客户订单的身份识别。</view>

  <view class="login__content">
    <view class="login__section-title">选择登录角色</view>
    <t-radio-group value="{{selectedRole}}" bind:change="onRoleChange">
      <t-radio
        wx:for="{{roleOptions}}"
        wx:key="value"
        label="{{item.label}}"
        value="{{item.value}}"
        borderless="{{false}}"
      />
    </t-radio-group>

    <view class="login__notice">{{authNotice}}</view>

    <view class="login__button">
      <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="login">
        微信登录并初始化资料
      </t-button>
    </view>
  </view>
</view>
