<sub-nav title="微信登录" fallback-url="/pages/my/index" hide-back="{{isGate}}" />
<view class="page login">
  <view class="login__title">登录团主早下班</view>
  <view class="login__subtitle">用于开团、团单和客户订单的身份识别。</view>

  <view class="login__content">
    <view class="login__notice">{{authNotice}}</view>

    <view wx:if="{{showLocalIdentity}}" class="login__local-identity">
      <view class="login__local-identity-label">测试身份（仅本地测试）</view>
      <input class="login__local-identity-input" value="{{localIdentity}}" placeholder="留空＝管理员，ivy1/ivy2/ivy3 见下方" bindinput="onLocalIdentityInput" />
      <view class="login__local-identity-tip">
        <view>留空＝管理员（owner）本人，全部功能都看得到。</view>
        <view>ivy1＝未通过审核的用户（用来看「审核中」被挡住的画面）。</view>
        <view>ivy2＝已通过审核的团主。</view>
        <view>ivy3＝一般客户（已过审，可直接下单）。</view>
        <view>其他名字＝各自独立的一般客户账号；角色只在第一次建号时决定，之后到「用户审核」改。</view>
      </view>
      <button class="login__reset-local" loading="{{isResettingLocalData}}" disabled="{{isResettingLocalData}}" bindtap="onResetLocalData">
        清空本地测试资料
      </button>
      <view class="login__local-identity-tip">
        <view>把本地测试资料库整个清空（团单／订单／商品／账号全没），并登出。云端资料不受影响。</view>
      </view>
    </view>

    <!-- 第一步：登录（老用户点完直接进，看不到名字栏） -->
    <view wx:if="{{!needName}}" class="login__button">
      <button class="login__native-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="login">
        微信登录
      </button>
    </view>

    <!-- 第二步：仅新用户登录后填一次显示名称 -->
    <block wx:if="{{needName}}">
      <view class="login__nickname">
        <input class="login__nickname-input" type="nickname" value="{{nickname}}" placeholder="显示名称（点此可带出微信昵称）" bindinput="onNicknameInput" bindblur="onNicknameInput" />
        <view class="login__nickname-tip">微信不允许自动读取昵称，首次登录请填一次；之后首页即显示该名称。</view>
      </view>
      <view class="login__button">
        <button class="login__native-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="confirmName">
          确认，进入
        </button>
      </view>
    </block>
  </view>
</view>
