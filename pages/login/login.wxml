<sub-nav title="微信登录" fallback-url="/pages/my/index" hide-back="{{isGate}}" />
<view class="page login">
  <view class="login__title">登录团主早下班</view>
  <view class="login__subtitle">用于开团、团单、商品库和客户订单的身份识别。</view>

  <view class="login__content">
    <view class="login__notice">{{authNotice}}</view>

    <view wx:if="{{showLocalIdentity}}" class="login__local-identity">
      <view class="login__local-identity-label">测试身份（本地测试用·留空即管理员本人）</view>
      <input class="login__local-identity-input" value="{{localIdentity}}" placeholder="填你的名字/编号，如 zhang3" bindinput="onLocalIdentityInput" />
      <view class="login__local-identity-tip">不同人填不同身份＝各自独立账号（默认客户，可在用户审核升级团主）。</view>
    </view>

    <view class="login__nickname">
      <input class="login__nickname-input" type="nickname" value="{{nickname}}" placeholder="显示名称（必填，点此可带出微信昵称）" bindinput="onNicknameInput" bindblur="onNicknameInput" />
      <view class="login__nickname-tip">微信不允许自动读取昵称，首次登录请填一次；之后首页即显示该名称。</view>
    </view>

    <view class="login__button">
      <button class="login__native-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="login">
        微信登录
      </button>
    </view>
  </view>
</view>
