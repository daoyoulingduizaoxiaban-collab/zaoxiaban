<t-navbar title="搜索" left-arrow fixed="{{true}}" placeholder="{{true}}" />
<view class="page search-page">
  <view wx:if="{{isAccessLoading}}" class="result-wrap">
    <t-empty icon="info-circle" description="正在确认搜索权限" />
  </view>
  <view wx:elif="{{!canUseSearch}}" class="result-wrap">
    <t-empty icon="info-circle" description="{{accessStateText}}" />
  </view>
  <view wx:else class="search-input">
    <t-search
      t-class-input-container="t-class__input-container"
      t-class-input="t-search__input"
      value="{{searchValue}}"
      action="取消"
      shape="round"
      placeholder="搜索团单、商品或客户订单"
      bind:change="handleSearchChange"
      bind:submit="handleSubmit"
      bind:action-click="actionHandle"
      focus="{{searchFocus}}"
    ></t-search>
  </view>
  <view wx:if="{{canUseSearch}}" class="search-wrap">
    <view class="result-wrap" wx:if="{{hasSearched}}">
      <view class="search-header">
        <text class="search-title">搜索结果</text>
      </view>
      <view class="loading-row" wx:if="{{isSearching}}">正在搜索</view>
      <block wx:elif="{{resultGroups.length}}">
        <view class="result-group" wx:for="{{resultGroups}}" wx:key="title">
          <view class="result-group-title">{{item.title}}</view>
          <view
            class="result-item"
            wx:for="{{item.items}}"
            wx:for-item="result"
            wx:key="id"
            data-type="{{result.type}}"
            data-id="{{result.id}}"
            bindtap="openResult"
          >
            <view class="result-title">{{result.title}}</view>
            <view class="result-desc">{{result.desc}}</view>
          </view>
        </view>
      </block>
      <t-empty wx:else icon="search" description="{{accessStateText || '没有找到符合条件的结果'}}" />
    </view>

    <view class="history-wrap" wx:if="{{historyWords.length}}">
      <view class="search-header">
        <text class="search-title">最近搜索</text>
        <t-icon name="delete" size="large" class="search-clear" bind:click="handleClearHistory" />
      </view>
      <view class="search-content">
        <view
          class="search-item"
          hover-class="hover-history-item"
          wx:for="{{historyWords}}"
          bind:tap="handleHistoryTap"
          bindlongpress="deleteCurr"
          data-index="{{index}}"
          wx:key="*this"
        >
          <t-tag class="history-item margin-12" max-width="{{343}}" variant="light">{{item}}</t-tag>
        </view>
      </view>
    </view>
    <view class="popular-wrap">
      <view class="search-header">
        <text class="search-title">常用业务词</text>
      </view>
      <view class="search-content">
        <view
          class="search-item"
          hover-class="hover-history-item"
          wx:for="{{popularWords}}"
          bind:tap="handlePopularTap"
          data-index="{{index}}"
          wx:key="*this"
        >
          <t-tag class="popular-item margin-12" max-width="{{343}}" variant="light"> {{item}} </t-tag>
        </view>
      </view>
    </view>
  </view>
  <t-dialog
    visible="{{dialogShow}}"
    content="{{dialog.message}}"
    bindconfirm="confirm"
    bind:close="close"
    confirm-btn="确定"
    cancel-btn="{{dialog.showCancelButton ? '取消' : null}}"
    t-class-confirm="dialog__button-confirm"
    t-class-cancel="dialog__button-cancel"
  />
</view>
