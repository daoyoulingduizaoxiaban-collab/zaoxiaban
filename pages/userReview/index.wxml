<nav title-text="{{titleText}}" />

<view class="review-page">
  <view class="no-access" wx:if="{{!canReview}}">
    <t-empty icon="info-circle" description="当前账号没有用户审核权限" />
  </view>

  <view wx:else>
    <view class="review-summary">用户角色审核与期限</view>
    <t-empty wx:if="{{isLoading}}" icon="info-circle" description="正在加载审核列表" />
    <t-empty wx:elif="{{loadErrorText}}" icon="info-circle" description="{{loadErrorText}}" />
    <t-cell-group theme="card" wx:elif="{{users.length}}">
      <view class="review-card" wx:for="{{users}}" wx:key="id">
        <t-cell title="{{item.displayName || item.name || '微信用户'}}" description="申请身份：{{item.requestedRoleLabel}}" note="{{item.accountNote}}" />
        <view class="section-label">可用角色</view>
        <view class="role-row">
          <button
            wx:for="{{item.reviewRoleOptions}}"
            wx:for-item="roleItem"
            wx:key="value"
            class="role-chip {{roleItem.selected ? 'role-chip--active' : ''}}"
            data-id="{{item.id || item._id}}"
            data-role="{{roleItem.value}}"
            bindtap="onRoleToggle"
          >
            {{roleItem.label}}
          </button>
        </view>
        <view class="expiry-row">
          <view class="section-label">使用期限</view>
          <input
            class="expiry-input"
            value="{{roleExpiresAtById[item.id || item._id]}}"
            data-id="{{item.id || item._id}}"
            placeholder="YYYY-MM-DD，留空表示不设期限"
            bindinput="onExpiresAtInput"
          />
        </view>
        <view class="action-row">
          <t-button theme="primary" size="small" data-id="{{item.id || item._id}}" data-status="approved" bindtap="reviewUser">通过</t-button>
          <t-button theme="danger" variant="outline" size="small" data-id="{{item.id || item._id}}" data-status="rejected" bindtap="reviewUser">拒绝</t-button>
          <t-button theme="default" variant="outline" size="small" data-id="{{item.id || item._id}}" data-status="disabled" bindtap="reviewUser">停用</t-button>
        </view>
      </view>
    </t-cell-group>
    <t-empty wx:else icon="info-circle" description="暂无可审核用户" />
  </view>
</view>
