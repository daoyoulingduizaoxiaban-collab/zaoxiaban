<nav title-text="{{titleText}}" />

<view class="review-page">
  <page-state
    state="{{pageState}}"
    loading-text="正在加载审核列表"
    error-text="{{stateText}}"
    empty-text="{{stateText}}"
    bind:retry="refresh"
  >
    <view class="review-filter">
      <view class="review-filter-tab {{filterMode === 'all' ? 'review-filter-tab--active' : ''}}" data-mode="all" bindtap="onFilterChange">全部用户</view>
      <view class="review-filter-tab {{filterMode === 'pending' ? 'review-filter-tab--active' : ''}}" data-mode="pending" bindtap="onFilterChange">待审核{{pendingCount ? '（' + pendingCount + '）' : ''}}</view>
    </view>
    <view class="review-summary">查看全部用户的角色与状态，可改角色 / 停用 / 设期限 / 审核</view>
    <t-cell-group theme="card">
      <view class="review-card" wx:for="{{users}}" wx:key="id">
        <t-cell title="{{item.displayName || item.name || '微信用户'}}" description="当前角色：{{item.requestedRoleLabel}}" note="{{item.accountNote}}" />
        <view class="section-label">可用角色</view>
        <view class="role-row">
          <button
            wx:for="{{item.reviewRoleOptions}}"
            wx:for-item="roleItem"
            wx:key="value"
            class="role-chip {{roleItem.selected ? 'role-chip--active' : ''}}"
            data-id="{{item.id || item._id}}"
            data-role="{{roleItem.value}}"
            bindtap="onRoleToggle"
          >
            {{roleItem.label}}
          </button>
        </view>
        <view class="expiry-row">
          <view class="section-label">使用期限</view>
          <view class="expiry-control">
            <picker
              mode="date"
              class="expiry-picker"
              value="{{roleExpiresAtById[item.id || item._id]}}"
              data-id="{{item.id || item._id}}"
              bindchange="onExpiresAtChange"
            >
              <view class="expiry-value {{roleExpiresAtById[item.id || item._id] ? '' : 'expiry-value--placeholder'}}">
                {{roleExpiresAtById[item.id || item._id] || '点击选择到期日（留空表示不设期限）'}}
              </view>
            </picker>
            <view
              wx:if="{{roleExpiresAtById[item.id || item._id]}}"
              class="expiry-clear"
              data-id="{{item.id || item._id}}"
              bindtap="onExpiresAtClear"
            >清除</view>
          </view>
        </view>
        <view class="action-row">
          <t-button theme="primary" size="small" data-id="{{item.id || item._id}}" bindtap="approveUser">通过</t-button>
          <t-button theme="danger" variant="outline" size="small" data-id="{{item.id || item._id}}" data-status="rejected" bindtap="openReviewDialog">拒绝</t-button>
          <t-button theme="default" variant="outline" size="small" data-id="{{item.id || item._id}}" data-status="disabled" bindtap="openReviewDialog">停用</t-button>
        </view>
      </view>
    </t-cell-group>
  </page-state>
</view>

<view wx:if="{{reviewDialogVisible}}" class="review-dialog-mask" catchtap="closeReviewDialog">
  <view class="review-dialog" catchtap="stopPropagation">
    <view class="review-dialog-title">{{reviewDialogTitle}}</view>
    <view class="review-dialog-tip">此操作需填写原因，提交后将记录并通知处理结果。</view>
    <textarea
      class="review-dialog-input"
      value="{{reviewReason}}"
      placeholder="请填写原因（必填）"
      maxlength="200"
      bindinput="onReasonInput"
    />
    <view class="review-dialog-actions">
      <t-button theme="default" variant="outline" size="small" bindtap="closeReviewDialog">取消</t-button>
      <t-button theme="danger" size="small" bindtap="confirmReview">确认提交</t-button>
    </view>
  </view>
</view>
