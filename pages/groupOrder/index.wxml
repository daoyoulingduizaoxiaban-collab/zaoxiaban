<nav nav-type="groupOrder" titleText="{{titleText}}" />
<view class="filter-section" wx:if="{{canUseBusiness}}">
  <t-search 
    value="{{searchKeyword}}" 
    placeholder="搜索团单名称或描述"
    bind:change="onSearchChange" 
    t-class="search-bar"
  />
  <t-dropdown-menu t-class="dropdown-custom">
    <t-dropdown-item 
      options="{{statusOptions}}" 
      value="{{currentStatus}}" 
      bind:change="onStatusChange" 
    />
  </t-dropdown-menu>
</view>

<view class="role-scope" wx:if="{{authReady}}">{{roleScopeText}}</view>

<view class="itinerary-container">
  <view class="access-card" wx:if="{{isNavigatingCreate}}">
    <view class="access-title">正在打开开团表单</view>
    <view class="access-desc">请稍候，系统正在进入团单编辑页。</view>
  </view>

  <view class="access-card" wx:elif="{{authReady && !isLoading && !canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">通过管理员确认身份后，可查看与你相关的团单。</view>
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <page-state
    wx:else
    state="{{pageState}}"
    loading-text="正在加载团单"
    error-text="{{loadErrorText}}"
    empty-text="{{emptyText}}"
    empty-cta-text="{{emptyCta}}"
    bind:retry="fetchItineraryList"
    bind:emptycta="onGroupEmptyCta"
  >
    <view class="group-card" wx:for="{{ itineraryList }}" wx:key="id">
      <view class="group-card__body" bind:tap="viewItinerary" data-id="{{ item.id }}">
        <view class="group-card__head">
          <text class="group-card__title">{{ item.title }}</text>
          <text class="group-card__status status-{{ item.status }}">{{ item.statusText }}</text>
        </view>
        <text class="group-card__desc" wx:if="{{ item.description }}">{{ item.description }}</text>
        <view class="group-card__stats" wx:if="{{ item.canManage }}">
          <text class="group-card__stat">人数 {{ item.totalCustomers || 0 }}</text>
          <text class="group-card__stat">已收 ¥{{ item.totalReceived || 0 }} / 应收 ¥{{ item.totalReceivable || 0 }}</text>
        </view>
      </view>
      <view class="group-card__actions" wx:if="{{ item.canManage }}">
        <text class="group-card__action" data-id="{{ item.id }}" catchtap="onCopyItinerary">复制</text>
        <text class="group-card__action group-card__action--danger" data-id="{{ item.id }}" catchtap="onDeleteItinerary">删除</text>
      </view>
    </view>
  </page-state>

  <t-fab wx:if="{{canCreateGroupOrder}}" icon="add" bind:tap="addItinerary" aria-label="新建团单"
    style="right: 32rpx; bottom: 180rpx;" />

</view>
