<nav nav-type="groupOrder" titleText="{{titleText}}" />
<view class="filter-section" wx:if="{{canUseBusiness}}">
  <t-search 
    value="{{searchKeyword}}" 
    placeholder="搜索团单名称或描述"
    bind:change="onSearchChange" 
    t-class="search-bar"
  />
  <t-dropdown-menu t-class="dropdown-custom">
    <t-dropdown-item 
      options="{{statusOptions}}" 
      value="{{currentStatus}}" 
      bind:change="onStatusChange" 
    />
  </t-dropdown-menu>
</view>

<view class="role-scope">{{roleScopeText}}</view>

<view class="itinerary-container">
  <view class="access-card" wx:if="{{!canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">通过管理员确认身份后，可查看与你相关的团单。</view>
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <view wx:if="{{canUseBusiness && isLoading}}" class="empty-wrapper">
    <t-empty icon="info-circle" description="正在加载团单" t-class-description="empty-text" />
  </view>

  <view wx:elif="{{canUseBusiness && loadErrorText}}" class="empty-wrapper">
    <t-empty icon="info-circle" description="{{loadErrorText}}" t-class-description="empty-text" />
  </view>

  <t-cell-group theme="card" wx:elif="{{canUseBusiness}}">
    <block wx:for="{{ itineraryList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="{{ item.description }}" hover arrow="{{false}}"
        bind:tap="viewItinerary" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
        <t-icon slot="left-icon" name="bulletpoint" size="44rpx" color="#0052d9" />
      </t-cell>
    </block>
  </t-cell-group>

  <view wx:if="{{canUseBusiness && !isLoading && !loadErrorText && itineraryList.length === 0}}" class="empty-wrapper">
    <t-empty icon="info-circle" description="暂无团单" t-class-description="empty-text">
      <view slot="action">
        <t-button wx:if="{{canCreateGroupOrder}}" theme="primary" size="small" bindtap="addItinerary">
          新建团单
        </t-button>
        <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">
          去登录
        </t-button>
        <t-button wx:if="{{isLoggedIn && !canCreateGroupOrder}}" theme="primary" variant="outline" size="small">
          暂无可查看团单
        </t-button>
      </view>
    </t-empty>
  </view>

  <t-fab wx:if="{{canCreateGroupOrder}}" icon="add" bind:click="addItinerary" bind:tap="addItinerary" aria-label="新建团单"
    style="right: 32rpx; bottom: 180rpx;" />

</view>
