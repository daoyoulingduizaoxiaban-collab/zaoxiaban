<nav nav-type="groupOrder" titleText="{{titleText}}" />
<view class="filter-section" wx:if="{{canUseBusiness}}">
  <t-search 
    value="{{searchKeyword}}" 
    placeholder="搜索团单名称或描述"
    bind:change="onSearchChange" 
    t-class="search-bar"
  />
  <t-dropdown-menu t-class="dropdown-custom">
    <t-dropdown-item 
      options="{{statusOptions}}" 
      value="{{currentStatus}}" 
      bind:change="onStatusChange" 
    />
  </t-dropdown-menu>
</view>

<view class="create-entry" wx:if="{{canCreateGroupOrder}}">
  <button class="create-entry__button" bindtap="addItinerary">新建团单</button>
</view>

<view class="role-scope" wx:if="{{authReady}}">{{roleScopeText}}</view>

<view class="itinerary-container">
  <view class="access-card" wx:if="{{isNavigatingCreate}}">
    <view class="access-title">正在打开开团表单</view>
    <view class="access-desc">请稍候，系统正在进入团单编辑页。</view>
  </view>

  <view class="access-card" wx:elif="{{authReady && !isLoading && !canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">通过管理员确认身份后，可查看与你相关的团单。</view>
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <page-state
    wx:else
    state="{{pageState}}"
    loading-text="正在加载团单"
    error-text="{{loadErrorText}}"
    empty-text="{{emptyText}}"
    empty-cta-text="{{emptyCta}}"
    bind:retry="fetchItineraryList"
    bind:emptycta="onGroupEmptyCta"
  >
    <t-cell-group theme="card">
      <block wx:for="{{ itineraryList }}" wx:key="id">
        <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="{{ item.description }}" hover arrow="{{false}}"
          bind:tap="viewItinerary" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
          <t-icon slot="left-icon" name="bulletpoint" size="44rpx" color="#0052d9" />
        </t-cell>
        <view class="row-actions">
          <button size="mini" plain bindtap="viewItinerary" data-id="{{item.id}}">查看详情</button>
        </view>
      </block>
    </t-cell-group>
  </page-state>

  <t-fab wx:if="{{canCreateGroupOrder}}" icon="add" bind:tap="addItinerary" aria-label="新建团单"
    style="right: 32rpx; bottom: 180rpx;" />

</view>
