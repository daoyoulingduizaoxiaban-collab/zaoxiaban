<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <t-cell-group theme="card">
    <t-input label="行程名稱" placeholder="請輸入1~20個字元" value="{{ formData.title }}" />
    <t-input label="行程狀態" value="{{ formData.statusText }}" />
    <t-input label="描述" value="{{ formData.description }}" />
    <!-- <t-cell title="出發日期" note="{{ formData.date || '請選擇' }}" arrow bind:tap="showDatePicker" /> -->
  </t-cell-group>
  
<!-- TODO iterator錯誤 -->
 
  <block wx:for="{{formData.orders}}" wx:key="id" wx:for-item="order">
    <view class="order-card">
      
      <view class="order-header">
        <text class="order-no">訂單編號：#{{order.id}}</text>
        <text class="order-status {{order.orderStatus === 1 ? 'status-done' : 'status-pending'}}">
          {{order.orderStatus === 1 ? '已完成' : '待付款'}}
        </text>
      </view>

      <view class="order-body">
        <view class="info-item">
          <text class="label">客戶 ID：</text>
          <text class="value">{{order.customerId}}</text>
        </view>
        <view class="info-item">
          <text class="label">商品數量：</text>
          <text class="value">{{order.items.length || 0}} 件</text>
        </view>
        <view class="info-item">
          <text class="label">應付總額：</text>
          <text class="value price">￥{{order.totalAmount}}</text>
        </view>
      </view>

      <view class="order-footer">
        <button class="btn-detail" size="mini" bindtap="goToOrderDetail" data-id="{{order.id}}">
          查看詳情
        </button>
      </view>
      
    </view>
  </block>

  <view wx:if="{{item.orders.length === 0}}" class="empty-msg">
    目前尚無訂購資料
  </view>

  <view wx:if="{{item.orders.length === 0}}" class="empty-msg">
    目前尚無訂購資料
  </view>

  <view class="submit-bar">
    <t-button theme="primary" size="large" block bind:tap="onSave">保存行程</t-button>
  </view>
</view>