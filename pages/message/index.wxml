<nav nav-type="title" title-text="订单提醒" />

<view class="message-list">
  <page-state
    state="{{pageState}}"
    error-text="{{stateText}}"
    empty-text="{{stateText}}"
    empty-cta-text="{{emptyCta}}"
    bind:retry="loadMessages"
    bind:emptycta="goCustomerOrders"
  >
    <t-cell-group theme="card">
      <t-cell
        wx:for="{{messages}}"
        wx:key="id"
        title="{{item.title}}"
        description="{{item.desc}}"
        note="{{item.isRead ? '已读' : '未读提醒'}}"
        arrow
        data-id="{{item.id}}"
        data-order-id="{{item.orderId}}"
        bind:tap="openOrder"
      />
    </t-cell-group>
  </page-state>
</view>
