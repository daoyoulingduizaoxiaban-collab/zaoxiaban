<nav nav-type="title" title-text="消息" />

<view class="message-list">
  <view wx:if="{{disabledReason}}">
    <t-empty icon="info-circle" description="{{disabledReason}}" />
  </view>
  <view wx:elif="{{isLoading}}">
    <t-loading theme="spinner" size="48rpx" />
  </view>
  <t-cell-group wx:elif="{{messages.length}}" theme="card">
    <t-cell
      wx:for="{{messages}}"
      wx:key="id"
      title="{{item.title}}"
      description="{{item.desc}}"
      note="{{item.isRead ? '已读' : '未读'}}"
      arrow
      data-id="{{item.id}}"
      data-order-id="{{item.orderId}}"
      bind:tap="openOrder"
    />
  </t-cell-group>
  <view wx:else>
    <t-empty icon="chat" description="暂无消息" />
    <t-button theme="primary" size="large" block bind:tap="goCustomerOrders">查看客户订单</t-button>
  </view>
</view>
