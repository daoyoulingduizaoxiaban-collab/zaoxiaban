<nav nav-type="title" title-text="订单提醒" />

<view class="message-list">
  <page-state
    state="{{pageState}}"
    error-text="{{stateText}}"
    empty-text="{{stateText}}"
    empty-cta-text="{{emptyCta}}"
    bind:retry="loadMessages"
    bind:emptycta="goCustomerOrders"
  >
    <t-cell-group theme="card">
      <t-cell
        wx:for="{{messages}}"
        wx:key="id"
        title="{{item.title}}"
        description="{{item.desc}}"
        note="{{item.isRead ? '已读' : '未读提醒'}}"
        arrow
        data-id="{{item.id}}"
        data-order-id="{{item.orderId}}"
        bind:tap="openOrder"
      />
    </t-cell-group>
  </page-state>
</view>

<view wx:if="{{detailVisible}}" class="message-detail-mask" catchtap="closeMessageDetail">
  <view class="message-detail-panel" catchtap="stopMessageDetailTap">
    <view class="message-detail-title">{{selectedMessage.title}}</view>
    <view class="message-detail-desc">{{selectedMessage.desc}}</view>
    <view class="message-detail-state">提醒已标记为已读，即将打开对应订单。</view>
    <button class="message-detail-close" bindtap="closeMessageDetail">知道了</button>
  </view>
</view>
