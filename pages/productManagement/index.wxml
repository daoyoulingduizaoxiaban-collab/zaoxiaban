<nav nav-type="productManagement" titleText="{{titleText}}" />

<view class="container">
  <view class="search-section" wx:if="{{canUseBusiness}}">
    <t-search value="{{searchQuery}}" placeholder="搜索商品名称或描述" bind:change="onSearchInput" t-class="search-bar" />
    <t-dropdown-menu t-class="dropdown-custom">
      <t-dropdown-item options="{{statusOptions}}" value="{{currentStatus}}" bind:change="onStatusChange" />
    </t-dropdown-menu>
    <button class="list-entry" bindtap="onOpenProductList">列表</button>
  </view>

  <view class="mode-banner">
    <text>{{roleScopeText}}</text>
    <text wx:if="{{saveModeText}}">{{saveModeText}}</text>
  </view>

  <view class="access-card" wx:if="{{!canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">通过管理员确认身份后，可查看与你角色对应的商品库。</view>
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <scroll-view scroll-y="true" class="product-list" wx:if="{{canUseBusiness}}">
    <view class="empty-container" wx:if="{{isLoading}}">
      <image class="empty-img" src="/static/avatar1.png" mode="aspectFit"></image>
      <text class="empty-text">正在加载商品</text>
    </view>

    <view class="empty-container" wx:elif="{{loadErrorText}}">
      <image class="empty-img" src="/static/avatar1.png" mode="aspectFit"></image>
      <text class="empty-text">{{loadErrorText}}</text>
      <text class="empty-tips">请稍后刷新页面重试</text>
    </view>

    <view class="empty-container" wx:elif="{{productList.length === 0}}">
      <image class="empty-img" src="/static/avatar1.png" mode="aspectFit"></image>
      <text class="empty-text">当前没有商品</text>
      <text class="empty-tips">{{isLoggedIn ? (canManageProducts ? '可点击右下角新增，资料会同步保存' : '当前账号暂无可管理商品') : '请登录后查看可管理的商品库'}}</text>
      <t-button wx:if="{{!isLoggedIn}}" t-class="empty-login" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
    </view>

    <block wx:else wx:for="{{productList}}" wx:key="id">
      <view class="product-card" bindtap="onOpenDetail" data-id="{{item.id}}">
        <view class="product-card-body">
          <image class="product-img" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
          <view class="product-info">
            <view class="title-row">
              <text class="title">{{item.title}}</text>
              <text
                class="status-tag {{item.status === 2 ? 'online' : 'offline'}}">{{productStatusTextMap[item.status]}}</text>
            </view>
            <text class="description">{{item.description || '暂无描述'}}</text>
            <text class="description">{{item.sourceNote || '暂无供应来源备注'}}</text>
          </view>
        </view>
        <view class="action-bar" wx:if="{{canManageProducts}}">
          <button size="mini" plain catchtap="onEditProduct" data-id="{{item.id}}">编辑</button>
          <button size="mini" type="warn" plain catchtap="onDelete" data-id="{{item.id}}">删除</button>
          <button size="mini" plain catchtap="onToggleStatus" data-id="{{item.id}}">
            {{item.status === 2 ? '下架' : '上架'}}
          </button>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="fab-btn" wx:if="{{canManageProducts}}" bindtap="onAddProduct">
    <text class="plus">+</text>
  </view>

  <view wx:if="{{detailVisible}}" class="detail-mask" catchtap="closeDetail">
    <view class="detail-panel" catchtap="stopDetailTap">
      <image class="detail-img" src="{{selectedProduct.coverUrl}}" mode="aspectFill" binderror="onDetailImageError" />
      <view class="detail-content">
        <view class="detail-title">{{selectedProduct.title}}</view>
        <view class="detail-section">
          <text class="detail-label">商品描述</text>
          <text class="detail-text">{{selectedProduct.description || '暂无描述'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">价格规则</text>
          <block wx:if="{{selectedPriceRules.length}}">
            <view class="price-rule" wx:for="{{selectedPriceRules}}" wx:key="minQuantity">
              <text>{{item.minQuantity}} 件起</text>
              <text>￥{{item.unitPrice}}</text>
              <text wx:if="{{item.description}}" class="price-rule__note">{{item.description}}</text>
            </view>
          </block>
          <text wx:else class="detail-text">未设置</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">供应来源</text>
          <text class="detail-text">{{selectedProduct.sourceNote || '暂无'}}</text>
        </view>
      </view>
      <button wx:if="{{canManageProducts}}" class="detail-close" data-id="{{selectedProduct.id}}" bindtap="onEditProduct">编辑商品</button>
      <button class="detail-close" bindtap="closeDetail">知道了</button>
    </view>
  </view>
</view>
