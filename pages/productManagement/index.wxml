<nav nav-type="productManagement" titleText="{{titleText}}" />

<view class="container">
  <view class="search-section">
    <t-search value="{{searchQuery}}" placeholder="搜索商品名称或描述" bind:change="onSearchInput" t-class="search-bar" />
    <t-dropdown-menu t-class="dropdown-custom">
      <t-dropdown-item options="{{statusOptions}}" value="{{currentStatus}}" bind:change="onStatusChange" />
    </t-dropdown-menu>
  </view>

  <view class="mode-banner">
    <text>{{roleScopeText}}</text>
    <text wx:if="{{saveModeText}}">{{saveModeText}}</text>
  </view>

  <scroll-view scroll-y="true" class="product-list">
    <view class="empty-container" wx:if="{{productList.length === 0}}">
      <image class="empty-img" src="/static/avatar1.png" mode="aspectFit"></image>
      <text class="empty-text">当前没有商品</text>
      <text class="empty-tips">{{isLoggedIn ? (canManageProducts ? '可点击右下角新增，资料将保存到微信云端' : '当前账号暂无可管理商品') : '请登录后查看可管理的商品库'}}</text>
      <t-button wx:if="{{!isLoggedIn}}" t-class="empty-login" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
    </view>

    <block wx:for="{{productList}}" wx:key="id">
      <view class="product-card">
        <view class="product-card-body">
          <image class="product-img" src="{{item.pictureUrls[0] || ''}}" mode="aspectFill"></image>
          <view class="product-info">
            <view class="title-row">
              <text class="title">{{item.title}}</text>
              <text
                class="status-tag {{item.status === 2 ? 'online' : 'offline'}}">{{productStatusTextMap[item.status]}}</text>
            </view>
            <text class="description">{{item.description || '暂无描述'}}</text>
            <text class="description">{{item.sourceNote || '暂无供应来源备注'}}</text>
          </view>
        </view>
        <view class="action-bar" wx:if="{{canManageProducts}}">
          <button size="mini" type="warn" plain bindtap="onDelete" data-id="{{item.id}}">删除</button>
          <button size="mini" plain bindtap="onToggleStatus" data-id="{{item.id}}">
            {{item.status === 2 ? '下架' : '上架'}}
          </button>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="fab-btn" wx:if="{{canManageProducts}}" bindtap="onAddProduct">
    <text class="plus">+</text>
  </view>
</view>
