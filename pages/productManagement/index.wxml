<nav nav-type="productManagement" titleText="{{titleText}}" />

<view class="container">
  <view class="search-section" wx:if="{{canShowProductCatalog}}">
    <t-search value="{{searchQuery}}" placeholder="搜索商品名称或描述" bind:change="onSearchInput" t-class="search-bar" />
    <t-dropdown-menu wx:if="{{canUseBusiness}}" t-class="dropdown-custom">
      <t-dropdown-item options="{{statusOptions}}" value="{{currentStatus}}" bind:change="onStatusChange" />
    </t-dropdown-menu>
    <button class="list-entry" bindtap="onOpenProductList">浏览</button>
    <button class="list-entry" wx:if="{{canManageProviders}}" bindtap="onOpenProviders">供应商</button>
  </view>

  <view class="mode-banner">
    <text>{{roleScopeText}}</text>
  </view>

  <view class="access-card" wx:if="{{authReady && !isLoading && !canUseBusiness}}">
    <view class="access-title">{{accessStateText}}</view>
    <view class="access-desc">可先浏览公开商品；下单、管理商品或查看专属资料需登录并通过身份确认。</view>
    <t-button wx:if="{{!isLoggedIn}}" theme="primary" size="small" bindtap="onLogin">去登录</t-button>
  </view>

  <scroll-view scroll-y="true" class="product-list" wx:if="{{canShowProductCatalog}}">
    <page-state
      state="{{pageState}}"
      loading-text="正在加载商品"
      error-text="{{loadErrorText}}"
      empty-text="{{emptyText}}"
      empty-cta-text="{{emptyCta}}"
      bind:retry="fetchData"
      bind:emptycta="onLogin"
    >
      <block wx:for="{{productList}}" wx:key="id">
        <view class="product-card">
          <view class="product-card-body" bindtap="onOpenDetail" data-id="{{item.id}}">
            <view class="product-img-wrap" bindtap="onOpenDetail" data-id="{{item.id}}">
              <image wx:if="{{item.coverUrl && !item.isImageFallback}}" class="product-img" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
              <view wx:if="{{item.isImageFallback}}" class="image-fallback">
                <view class="image-fallback__mark">品</view>
                <view class="image-fallback__text">{{item.imageFallbackText}}</view>
              </view>
            </view>
            <view class="product-info" bindtap="onOpenDetail" data-id="{{item.id}}">
              <view class="title-row">
                <text class="title">{{item.title}}</text>
                <text
                  class="status-tag {{item.status === 2 ? 'online' : 'offline'}}">{{productStatusTextMap[item.status]}}</text>
              </view>
              <text class="description">{{item.description || '暂无描述'}}</text>
              <!-- 补上价格：本页原本整张卡都不显示对外价格，其他列出商品的页面都有 -->
              <text class="description">{{item.priceDisplay || '未设置价格'}}</text>
              <text class="description">{{item.sourceNote || '暂无供应来源备注'}}</text>
            </view>
          </view>
          <view class="action-bar">
            <button class="detail-entry-btn" size="mini" plain catchtap="onOpenDetail" data-id="{{item.id}}">
              <t-icon name="search" size="28rpx" color="#0052d9" />
              <text>查看详情</text>
            </button>
            <button wx:if="{{canManageProducts}}" size="mini" plain catchtap="onEditProduct" data-id="{{item.id}}">编辑</button>
            <button wx:if="{{canManageProducts}}" size="mini" type="warn" plain catchtap="onDelete" data-id="{{item.id}}">删除</button>
            <button wx:if="{{canManageProducts}}" size="mini" plain catchtap="onToggleStatus" data-id="{{item.id}}">
              {{item.status === 2 ? '下架' : '上架'}}
            </button>
          </view>
        </view>
      </block>
    </page-state>
  </scroll-view>

  <button class="fab-btn" wx:if="{{canManageProducts}}" bindtap="onAddProduct" aria-label="新增商品">
    <text class="plus">+</text>
  </button>

  <view wx:if="{{detailVisible}}" class="detail-mask" catchtap="closeDetail">
    <view class="detail-panel" catchtap="stopDetailTap">
      <view class="detail-img-wrap">
        <image wx:if="{{selectedProduct.coverUrl && !selectedProduct.isImageFallback}}" class="detail-img" src="{{selectedProduct.coverUrl}}" mode="aspectFill" binderror="onDetailImageError" />
        <view wx:if="{{selectedProduct.isImageFallback}}" class="detail-image-fallback">
          <view class="detail-image-fallback__mark">品</view>
          <view class="detail-image-fallback__text">{{selectedProduct.imageFallbackText}}</view>
        </view>
      </view>
      <view class="detail-content">
        <view class="detail-title">{{selectedProduct.title}}</view>
        <view class="detail-section">
          <text class="detail-label">商品描述</text>
          <text class="detail-text">{{selectedProduct.description || '暂无描述'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">价格规则</text>
          <block wx:if="{{selectedPriceRules.length}}">
            <!-- 总价口径：本页原本印单价，本团商品弹窗印总价，同一组价格档两页数字不同。
                 全站对外一律用总价（75c18d2 / ea7386e 确立）。 -->
            <view class="price-rule" wx:for="{{selectedPriceRules}}" wx:key="minQuantity">
              <text>{{item.minQuantity}} 件</text>
              <text>¥{{item.totalPrice}}</text>
              <text wx:if="{{item.description}}" class="price-rule__note">{{item.description}}</text>
            </view>
          </block>
          <text wx:else class="detail-text">未设置</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">供应来源</text>
          <text class="detail-text">{{selectedProduct.sourceNote || '暂无'}}</text>
        </view>
      </view>
      <view class="detail-actions">
        <button wx:if="{{canManageProducts}}" class="detail-action detail-action--secondary" data-id="{{selectedProduct.id}}" bindtap="onEditProduct">编辑商品</button>
        <button class="detail-action" bindtap="closeDetail">知道了</button>
      </view>
    </view>
  </view>
</view>
