<nav nav-type="providers" titleText="{{titleText}}" />

<view class="providers-container">
  <view wx:if="{{disabledReason}}" class="mode-tip">{{disabledReason}}</view>
  <t-cell-group theme="card">
    <block wx:for="{{ providersList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.statusText }}" description="{{ item.contact }}｜{{ item.note }}" hover arrow
        bind:tap="goToDetail" data-id="{{ item.id }}" t-class-note="status-{{ item.status }}">
        <t-icon slot="left-icon" name="shop" size="48rpx" color="#0052d9" />
      </t-cell>
    </block>
  </t-cell-group>

  <view wx:if="{{providersList.length === 0}}" class="empty-state">
    <t-empty icon="info-circle" description="{{disabledReason || '暂无供应商资料'}}" />
  </view>

  <t-fab wx:if="{{!disabledReason}}" icon="add" bind:click="onGoToEdit" bind:tap="onGoToEdit" aria-label="新增供应商" style="right: 32rpx; bottom: 180rpx;" />

</view>
