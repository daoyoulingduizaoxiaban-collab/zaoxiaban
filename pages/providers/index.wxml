<nav nav-type="providers" titleText="{{titleText}}" />

<view class="providers-container">
  <view wx:if="{{disabledReason}}" class="mode-tip">{{disabledReason}}</view>
  <t-cell-group theme="card">
    <block wx:for="{{ providersList }}" wx:key="id">
      <t-cell title="{{ item.title }}" note="{{ item.stateLabel }}" description="{{ item.contactText }}｜{{ item.noteText }}" hover arrow
        bind:tap="goToDetail" data-id="{{ item.id }}" t-class-note="{{ item.isDisabled ? 'provider-disabled' : '' }}">
        <t-icon slot="left-icon" name="shop" size="48rpx" color="{{ item.isDisabled ? '#c0c4cc' : '#0052d9' }}" />
      </t-cell>
    </block>
  </t-cell-group>

  <view wx:if="{{providersList.length === 0}}" class="empty-state">
    <t-empty icon="info-circle" description="{{disabledReason || '暂无供应商资料'}}" />
  </view>

  <t-fab wx:if="{{!disabledReason}}" icon="{{providerActionIcon}}" bind:click="onGoToEdit" bind:tap="onGoToEdit" aria-label="{{providerActionLabel}}" style="right: 32rpx; bottom: 180rpx;" />

</view>
