<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <t-cell-group theme="card">
    <t-input label="供應名稱" placeholder="請輸入供應名稱" value="{{ formData.title }}" />
    <t-cell title="出發日期" note="{{ formData.date || '請選擇' }}" arrow bind:tap="showDatePicker" />
    <t-input label="供應狀態" value="{{ formData.statusText }}" disabled />
  </t-cell-group>

  <view class="submit-bar">
    <t-button theme="primary" size="large" block bind:tap="onSave">保存供應</t-button>
  </view>
</view>