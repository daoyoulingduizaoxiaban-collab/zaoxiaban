<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <view wx:if="{{!canSave}}" class="empty-state">
    <t-empty icon="info-circle" description="{{disabledReason}}" />
  </view>
  <view wx:elif="{{pageErrorText}}" class="empty-state">
    <t-empty icon="info-circle" description="{{pageErrorText}}" />
  </view>
  <t-cell-group wx:else theme="card">
    <t-input label="供应商名称" placeholder="请输入供应商名称" value="{{ formData.title }}" data-field="title" bind:change="onInputChange" />
    <t-input label="联系人" placeholder="请输入联系人" value="{{ formData.contact }}" data-field="contact" bind:change="onInputChange" />
    <t-input label="资料说明" placeholder="请输入供货或合作说明" value="{{ formData.note }}" data-field="note" bind:change="onInputChange" />
    <t-cell title="最近维护日期" note="{{ formData.date || '请选择' }}" arrow bind:tap="showDatePicker" />
    <t-input label="供应商状态" value="{{ formData.statusText }}" data-field="statusText" disabled="{{isApplyMode}}" bind:change="onInputChange" />
  </t-cell-group>

  <view class="submit-bar" wx:if="{{canSave && !pageErrorText}}">
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bind:tap="onSave">{{isApplyMode ? '提交申请' : '保存供应商'}}</t-button>
  </view>
</view>
