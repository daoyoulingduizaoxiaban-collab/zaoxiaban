<sub-nav title="本团商品" />

<view class="container">
  <view class="search-section">
    <view class="search-bar">
      <icon type="search" size="16" color="#999" />
      <input class="search-input" placeholder="搜索本团商品" bindinput="onSearchInput" value="{{searchQuery}}" />
      <view class="clear-icon" wx:if="{{searchQuery}}" bindtap="clearSearch">×</view>
    </view>
  </view>

  <scroll-view scroll-y class="product-list">
    <block wx:if="{{displayList.length > 0}}">
      <view class="product-card" wx:for="{{displayList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        
        <image class="p-img" src="{{item.pictureUrls[0] || '/static/icon_map.png'}}" mode="aspectFill" />
        
        <view class="p-info">
          <text class="p-title">{{item.title}}</text>
          <view class="p-price-row">
            <text class="p-description">{{item.description}}</text>
            <!-- <text class="p-sold">已售 {{item.soldCount || 0}}</text> -->
          </view>
          <view class="p-price-row">
          <text class="p-price">{{item.priceDisplay}}</text>
            <!-- <text class="p-sold">已售 {{item.soldCount || 0}}</text> -->
          </view>
        </view>

        <view class="p-action" catchtap="onDelete" data-index="{{index}}" data-id="{{item.id}}">
          <view class="btn-delete-icon">
            <text class="icon-trash">🗑️</text> </view>
          <text class="txt-del">移除</text>
        </view>

      </view>
    </block>

    <view wx:else class="empty-state">
      <image src="/static/icon_map.png" class="empty-img" mode="aspectFit" />
      <text>本团当前没有商品</text>
      <text class="sub-text">点击下方按钮从商品库加入</text>
    </view>
    
    <view class="list-spacer"></view>
  </scroll-view>

  <view class="footer-bar">
    <button class="btn-add-new" bindtap="goToLibrary">
      <text class="plus">+</text> 从商品库加入
    </button>
  </view>
</view>
