<sub-nav title="本团商品" />

<view class="container">
  <view class="search-section">
    <view class="search-bar">
      <icon type="search" size="16" color="#999" />
      <input class="search-input" placeholder="搜索本团商品" bindinput="onSearchInput" value="{{searchQuery}}" />
      <view class="clear-icon" wx:if="{{searchQuery}}" bindtap="clearSearch">×</view>
    </view>
  </view>

  <scroll-view scroll-y class="product-list">
    <view wx:if="{{isLoading}}" class="empty-state">
      <image src="/static/logo/zaoxiaban.png" class="empty-img" mode="aspectFit" />
      <text>正在加载本团商品</text>
    </view>

    <view wx:elif="{{pageErrorText}}" class="empty-state">
      <image src="/static/logo/zaoxiaban.png" class="empty-img" mode="aspectFit" />
      <text>{{pageErrorText}}</text>
    </view>

    <block wx:elif="{{displayList.length > 0}}">
      <view class="product-card" wx:for="{{displayList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        
        <view class="p-img-wrap">
          <image class="p-img" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError" />
          <view wx:if="{{item.isImageFallback}}" class="image-fallback-label">{{item.imageFallbackText}}</view>
        </view>
        
        <view class="p-info">
          <text class="p-title">{{item.title}}</text>
          <view class="p-price-row">
            <text class="p-description">{{item.description}}</text>
          </view>
          <view class="p-price-row">
          <text class="p-price">{{item.priceDisplay}}</text>
          </view>
        </view>

        <view class="p-action" catchtap="onDelete" data-index="{{index}}" data-id="{{item.id}}">
          <view class="btn-delete-icon">
            <t-icon name="delete" size="36rpx" color="#ff4d4f" />
          </view>
          <text class="txt-del">移除</text>
        </view>

      </view>
    </block>

    <view wx:else class="empty-state">
      <image src="/static/logo/zaoxiaban.png" class="empty-img" mode="aspectFit" />
      <text>本团当前没有商品</text>
      <text class="sub-text">点击下方按钮从商品库加入</text>
    </view>
    
    <view class="list-spacer"></view>
  </scroll-view>

  <view wx:if="{{!pageErrorText}}" class="footer-bar">
    <button class="btn-add-new" bindtap="goToLibrary" disabled="{{isLoading}}">
      <text class="plus">+</text> 从商品库加入
    </button>
  </view>

  <view wx:if="{{detailVisible}}" class="detail-mask" catchtap="closeProductDetail">
    <view class="detail-panel" catchtap="noop">
      <view class="detail-img-wrap">
        <image class="detail-img" src="{{selectedProduct.coverUrl}}" mode="aspectFill" binderror="onDetailImageError" />
        <view wx:if="{{selectedProduct.isImageFallback}}" class="detail-image-fallback-label">{{selectedProduct.imageFallbackText}}</view>
      </view>
      <view class="detail-content">
        <view class="detail-header">
          <text class="detail-title">{{selectedProduct.title}}</text>
          <text class="detail-status">{{selectedProduct.statusText}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">商品描述</text>
          <text class="detail-text">{{selectedProduct.description || '暂无描述'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">价格规则</text>
          <block wx:if="{{selectedPriceRules.length > 0}}">
            <view class="price-rule" wx:for="{{selectedPriceRules}}" wx:key="minQuantity">
              <text>{{item.minQuantity}} 件起</text>
              <text>¥{{item.unitPrice}}</text>
              <text wx:if="{{item.description}}" class="price-rule__note">{{item.description}}</text>
            </view>
          </block>
          <text wx:else class="detail-text">未设置</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">供应来源</text>
          <text class="detail-text">{{selectedProduct.sourceNote || '暂无'}}</text>
        </view>
      </view>
      <button class="detail-close" bindtap="closeProductDetail">知道了</button>
    </view>
  </view>
</view>
