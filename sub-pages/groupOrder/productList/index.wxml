<sub-nav title="本团商品" fallback-url="{{backFallbackUrl}}" />

<view class="container">
  <view wx:if="{{readOnly}}" class="readonly-banner">团单已停止收单，仅供查看，不能移除商品</view>
  <view class="search-section">
    <view class="search-bar">
      <t-icon name="search" size="32rpx" color="#999" />
      <input class="search-input" placeholder="搜索本团商品" bindinput="onSearchInput" value="{{searchQuery}}" />
      <view class="clear-icon" wx:if="{{searchQuery}}" bindtap="clearSearch">×</view>
    </view>
  </view>

  <scroll-view scroll-y class="product-list">
    <page-state
      state="{{pageState}}"
      loading-text="正在加载本团商品"
      error-text="{{loadErrorText}}"
      empty-text="{{emptyText}}"
      bind:retry="loadGroupProducts"
    >
      <view class="product-card" wx:for="{{displayList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        
        <view class="p-img-wrap">
          <image wx:if="{{item.coverUrl && !item.isImageFallback}}" class="p-img" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError" />
          <view wx:if="{{item.isImageFallback}}" class="image-fallback">
            <view class="image-fallback__mark">品</view>
            <view class="image-fallback__text">{{item.imageFallbackText}}</view>
          </view>
        </view>
        
        <view class="p-info">
          <text class="p-title">{{item.title}}</text>
          <view class="p-price-row">
            <text class="p-description">{{item.description}}</text>
          </view>
          <view class="p-price-row">
          <text class="p-price">{{item.priceDisplay}}</text>
          </view>
          <view class="detail-entry">查看详情</view>
        </view>

        <view wx:if="{{canManageGroupOrder && !readOnly}}" class="p-action" catchtap="onDelete" data-id="{{item.id}}">
          <view class="btn-delete-icon">
            <t-icon name="delete" size="36rpx" color="#ff4d4f" />
          </view>
          <text class="txt-del">移除</text>
        </view>

      </view>
    </page-state>

    <view class="list-spacer"></view>
  </scroll-view>

  <view wx:if="{{detailVisible}}" class="detail-mask" catchtap="closeProductDetail">
    <view class="detail-panel" catchtap="noop">
      <view class="detail-img-wrap">
        <image wx:if="{{selectedProduct.coverUrl && !selectedProduct.isImageFallback}}" class="detail-img" src="{{selectedProduct.coverUrl}}" mode="aspectFill" binderror="onDetailImageError" />
        <view wx:if="{{selectedProduct.isImageFallback}}" class="detail-image-fallback">
          <view class="detail-image-fallback__mark">品</view>
          <view class="detail-image-fallback__text">{{selectedProduct.imageFallbackText}}</view>
        </view>
      </view>
      <view class="detail-content">
        <view class="detail-header">
          <text class="detail-title">{{selectedProduct.title}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">商品描述</text>
          <text class="detail-text">{{selectedProduct.description || '暂无描述'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">价格规则</text>
          <block wx:if="{{selectedPriceRules.length > 0}}">
            <view class="price-rule" wx:for="{{selectedPriceRules}}" wx:key="minQuantity">
              <text>{{item.minQuantity}} 件</text>
              <text>总价 ¥{{item.totalPrice}}</text>
              <text wx:if="{{item.description}}" class="price-rule__note">{{item.description}}</text>
            </view>
          </block>
          <text wx:else class="detail-text">未设置</text>
        </view>
      </view>
      <button class="detail-close" bindtap="closeProductDetail">知道了</button>
    </view>
  </view>
</view>
