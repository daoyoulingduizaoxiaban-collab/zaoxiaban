<sub-nav title="{{pageTitle}}" fallback-url="{{sourceUrl}}" custom-back="{{true}}" bind:back="onBack" />

<view class="access-card" wx:if="{{isPageLoading}}">
  <view class="access-title">正在打开开团表单</view>
  <view class="access-desc">请稍候，系统正在初始化表单资料。</view>
</view>

<view class="access-card" wx:elif="{{accessDenied}}">
  <view class="access-title">{{accessStateText || '当前账号不能新建团单'}}</view>
  <view class="access-desc">请使用已通过审核的团主或管理员账号。</view>
</view>

<view class="access-card" wx:elif="{{pageErrorText}}">
  <view class="access-title">{{pageErrorText}}</view>
  <view class="access-desc">请返回团单列表后重新选择。</view>
</view>

<view class="add-container" wx:else>
  <view wx:if="{{readOnly}}" class="readonly-banner">团单已停止收单，仅供查看，不能编辑</view>

  <t-cell-group theme="card" title="基本信息">
    <t-input label="*名称" placeholder="最多20个字" maxlength="20" value="{{formData.title}}" disabled="{{readOnly}}" bindchange="onInput" data-field="title" />
    <view class="native-textarea-field">
      <view class="native-textarea-label">团单描述</view>
      <textarea
        class="native-textarea"
        value="{{formData.description}}"
        placeholder="最多200个字"
        maxlength="200"
        data-field="description"
        disabled="{{readOnly}}"
        bindinput="onInput"
      />
    </view>
    <view class="native-textarea-field">
      <view class="native-textarea-label">*出团时间</view>
      <view class="picker-display {{readOnly ? 'is-readonly' : ''}}" bindtap="openDatePicker" data-field="startAt">{{formData.startAt || '请选择出团时间（如 2026-07-10 09:00）'}}</view>
    </view>
    <view class="native-textarea-field">
      <view class="native-textarea-label">*收单截止</view>
      <view class="picker-display {{readOnly ? 'is-readonly' : ''}}" bindtap="openDatePicker" data-field="endAt">{{formData.endAt || '请选择收单截止时间（如 2026-07-09 20:00）'}}</view>
    </view>
    <view class="native-textarea-field">
      <view class="native-textarea-label">客户提示</view>
      <textarea
        class="native-textarea"
        value="{{formData.customerNotice}}"
        placeholder="下单前给客户看的补充说明"
        data-field="customerNotice"
        disabled="{{readOnly}}"
        bindinput="onInput"
      />
    </view>
  </t-cell-group>
  <view class="goods-section">
    <view class="goods-section-title">*商品设置</view>
    <view class="goods-list" wx:if="{{selectedGoods.length > 0}}">
      <view class="goods-item" wx:for="{{selectedGoods}}" wx:key="id">
        <view class="goods-thumb-wrap {{item.isImageFallback ? 'is-fallback' : ''}}">
          <image wx:if="{{item.coverUrl && !item.isImageFallback}}" class="goods-thumb" src="{{item.coverUrl}}" mode="aspectFill" data-index="{{index}}" binderror="onGoodsImageError" />
          <text wx:if="{{item.isImageFallback}}" class="goods-fallback-label">{{item.imageFallbackText || '暂无商品图片'}}</text>
        </view>
        <view class="goods-info">
          <view class="goods-title">{{item.title}}</view>
          <view class="price-tags-wrapper">
            <view class="price-badge" wx:for="{{item.priceSetting}}" wx:for-item="price" wx:key="minQuantity">
              {{price.minQuantity}}件 ¥{{price.totalPrice || price.unitPrice}}
            </view>
          </view>
        </view>
        <button class="remove-btn" disabled="{{readOnly}}" bindtap="onRemoveGoods" data-index="{{index}}">移除</button>
      </view>
    </view>

    <view class="add-goods-btn-wrap" wx:if="{{selectedGoods.length === 0}}">还没有商品，用下方表单直接新增</view>

    <!-- #8 内嵌新增商品：不必先去商品库，填名称 + 多档「数量+总价(支援小数)」直接加入。 -->
    <view class="inline-product" wx:if="{{!readOnly}}">
      <view class="inline-product__label">新增商品</view>
      <input class="inline-product__input" placeholder="商品名称" value="{{newProduct.title}}" bindinput="onNewProductInput" />

      <!-- 商品图（选填，最多 3 张） -->
      <view class="inline-images">
        <view class="inline-images__item" wx:for="{{newProduct.pictureUrls}}" wx:key="*this">
          <image class="inline-images__img" src="{{item}}" mode="aspectFill" />
          <text class="inline-images__remove" data-index="{{index}}" catchtap="removeInlineImage">×</text>
        </view>
        <view wx:if="{{newProduct.pictureUrls.length < 3}}" class="inline-images__add" bindtap="chooseInlineImage">＋ 商品图</view>
      </view>

      <!-- 已添加的价格档（如 3 件 ¥30、5 件 ¥45），第一档(1件)是基准价、不能删只能整组重来。 -->
      <view class="inline-tier" wx:for="{{newProduct.tiers}}" wx:key="minQuantity">
        <text class="inline-tier__text">{{item.minQuantity}} 件　总价 ¥{{item.totalPrice}}{{index === 0 ? '（基准价）' : ''}}</text>
        <text class="inline-tier__remove" data-index="{{index}}" bindtap="removeTier">{{index === 0 ? '重填' : '删除'}}</text>
      </view>

      <view class="inline-product__row">
        <input
          class="inline-product__input inline-product__input--half"
          type="number"
          placeholder="数量(件)"
          value="{{newProduct.tiers.length === 0 ? 1 : tempTier.minQuantity}}"
          disabled="{{newProduct.tiers.length === 0}}"
          data-field="minQuantity"
          bindinput="onTierInput"
        />
        <input class="inline-product__input inline-product__input--half" type="digit" placeholder="{{newProduct.tiers.length === 0 ? '1件多少钱(元,可小数)' : '该档总价(元,可小数)'}}" value="{{tempTier.totalPrice}}" data-field="totalPrice" bindinput="onTierInput" />
      </view>
      <button class="inline-product__tier-add" bindtap="addTier">{{newProduct.tiers.length === 0 ? '确定基准价' : '+ 添加价格档'}}</button>
      <button class="inline-product__add" bindtap="addProductInline">加入此商品</button>
    </view>
  </view>

  <t-date-time-picker
    visible="{{datePickerVisible}}"
    value="{{pickerValue}}"
    mode="{{['date', 'minute']}}"
    format="YYYY-MM-DD HH:mm"
    bindconfirm="onDatePickerConfirm"
    bindcancel="onDatePickerCancel"
  />

  <view class="footer" wx:if="{{!readOnly}}">
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSave">{{isEdit ? '保存团单' : '新建团单'}}</t-button>
  </view>
</view>
