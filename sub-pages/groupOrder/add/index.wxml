<sub-nav title="{{pageTitle}}" />

<view class="add-container">
  <view class="mode-tip">{{saveModeText}}</view>
  <t-cell-group theme="card" title="基本信息">
    <t-input label="*名称" placeholder="最多20个字" maxlength="20" value="{{formData.title}}" bindchange="onInput" data-field="title" />
    <t-textarea label="团单描述" placeholder="最多200个字" value="{{formData.description}}" bindchange="onInput" maxlength="200"
      data-field="description" />
    <t-input label="*出团时间" placeholder="例：2026-07-10 09:00" value="{{formData.startAt}}" bindchange="onInput" data-field="startAt" />
    <t-input label="*收单截止" placeholder="例：2026-07-09 20:00" value="{{formData.endAt}}" bindchange="onInput" data-field="endAt" />
    <t-textarea label="*取货/集合" placeholder="说明集合点、取货方式或交付安排" value="{{formData.pickupNote}}" bindchange="onInput" data-field="pickupNote" />
    <t-textarea label="*付款说明" placeholder="说明付款方式、收款账号、付款后如何备注" value="{{formData.paymentNote}}" bindchange="onInput" data-field="paymentNote" />
    <t-input label="*联系人" placeholder="导游/领队姓名" value="{{formData.contactName}}" bindchange="onInput" data-field="contactName" />
    <t-input label="*联系电话" placeholder="导游/领队手机号" value="{{formData.contactPhone}}" bindchange="onInput" data-field="contactPhone" />
    <t-textarea label="客户提示" placeholder="下单前给客户看的补充说明" value="{{formData.customerNotice}}" bindchange="onInput" data-field="customerNotice" />
  </t-cell-group>
  <t-cell-group theme="card" title="*商品设置">
    <view class="goods-list" wx:if="{{selectedGoods.length > 0}}">
      <view class="goods-item" wx:for="{{selectedGoods}}" wx:key="id">
        <image class="goods-thumb" src="{{item.pictureUrls[0]}}" mode="aspectFill" />
        <view class="goods-info">
          <view class="goods-title">{{item.title}}</view>
          <view class="price-tags-wrapper">
            <view class="price-badge" wx:for="{{item.priceSetting}}" wx:for-item="price" wx:key="minQuantity">
              {{price.minQuantity}}件起: ¥{{price.unitPrice}}
            </view>
          </view>
        </view>
        <view class="remove-btn" bindtap="onRemoveGoods" data-index="{{index}}">
          <t-icon name="close-circle-filled" size="40rpx" color="#ccc" />
        </view>
      </view>
    </view>

    <view class="add-goods-btn-wrap" bindtap="onSelectGoods">
      <t-icon name="add" size="48rpx" color="#0052d9" />
      <text class="add-text">添加团单商品</text>
    </view>
  </t-cell-group>

  <view class="footer">
    <t-button theme="primary" size="large" block loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSave">{{isEdit ? '保存团单' : '新建团单'}}</t-button>
  </view>
</view>
