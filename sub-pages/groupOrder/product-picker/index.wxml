<sub-nav title="从商品库选择" placeholder />

<view class="container">
  <view class="search-box" catchtap="focusSearch">
    <view class="search-inner {{searchActive ? 'is-active' : ''}}">
      <text class="search-label">搜</text>
      <input
        class="search-input"
        type="text"
        value="{{searchQuery}}"
        focus="{{searchFocus}}"
        placeholder="搜索商品名称"
        confirm-type="search"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
      />
      <button wx:if="{{searchQuery}}" class="search-clear" catchtap="clearSearch">清空</button>
    </view>
  </view>

  <scroll-view scroll-y class="product-list">
    <view wx:if="{{isLoading}}" class="empty-state">正在加载商品库</view>
    <view wx:elif="{{pageErrorText}}" class="empty-state">{{pageErrorText}}</view>

    <view wx:elif="{{products.length === 0}}" class="empty-state">
      <view class="empty-title">暂无可选商品</view>
      <view class="empty-desc">请先到商品库新增或启用商品后，再回到开团表单选择。</view>
      <button class="empty-action" bindtap="goProductLibrary">去商品库</button>
    </view>

    <block wx:else>
      <block wx:for="{{products}}" wx:key="id">
        <view class="product-item {{item.disabled ? 'is-disabled' : ''}} {{item.selected ? 'is-selected' : ''}}"
              bindtap="toggleSelect"
              data-id="{{item.id}}">

          <view class="checkbox" catchtap="toggleSelect" data-id="{{item.id}}">
            <text wx:if="{{item.selected}}" class="txt-selected">已选</text>
            <text wx:elif="{{item.disabled}}" class="txt-added">已加</text>
          </view>
          <view class="p-img-wrap {{item.isImageFallback ? 'is-fallback' : ''}}">
            <image wx:if="{{item.coverUrl && !item.isImageFallback}}" class="p-img" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
            <view wx:if="{{item.isImageFallback}}" class="image-fallback">
              <view class="image-fallback__mark">品</view>
              <view class="image-fallback__text">{{item.imageFallbackText || '暂无商品图片'}}</view>
            </view>
          </view>

          <view class="p-info">
            <text class="p-title">{{item.title}}</text>
            <text class="p-desc">{{item.description || '暂无描述'}}</text>
            <view class="p-price-row">
              <text class="p-price">{{item.priceDisplay}}</text>
            </view>
          </view>

        </view>
      </block>
    </block>
    
    <view class="footer-spacer"></view>
  </scroll-view>

  <view wx:if="{{!pageErrorText}}" class="footer-bar">
    <view class="selected-info">
      已选择 <text class="count">{{selectedCount}}</text> 项
    </view>
    <button class="btn-confirm {{selectedCount > 0 ? '' : 'disabled'}}" disabled="{{selectedCount === 0}}" bindtap="confirmAdd">
      确认加入
    </button>
  </view>
</view>
