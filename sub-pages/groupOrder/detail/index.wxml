<wxs src="../../../utils/utils.wxs" module="utils" />
<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <view class="mode-tip">{{saveModeText}}</view>

  <page-state
    state="{{pageState}}"
    loading-text="正在加载团单资料"
    error-text="{{loadErrorText}}"
    bind:retry="onRetry"
  >
    <view class="detail-info-card">
      <view class="detail-info-row">
        <text class="detail-info-label">团单名称</text>
        <text class="detail-info-value">{{groupOrder.title || '未填写'}}</text>
      </view>
      <view class="detail-info-row">
        <text class="detail-info-label">收单状态</text>
        <text class="detail-info-value">{{groupOrder.statusText || '未填写'}}</text>
      </view>
      <view class="detail-info-row">
        <text class="detail-info-label">描述</text>
        <text class="detail-info-value">{{groupOrder.description || '未填写'}}</text>
      </view>
      <view class="detail-info-row">
        <text class="detail-info-label">出团时间</text>
        <text class="detail-info-value">{{groupOrder.startAt || '未填写'}}</text>
      </view>
      <view class="detail-info-row">
        <text class="detail-info-label">收单截止</text>
        <text class="detail-info-value">{{groupOrder.endAt || '未填写'}}</text>
      </view>
      <view class="qr-container" bindtap="previewQR">
        <image wx:if="{{groupOrder.qrCodeUrl}}" class="qr-image" src="{{ groupOrder.qrCodeUrl }}" mode="aspectFit" binderror="onImageError"
          show-menu-by-longpress />
        <view wx:else class="qr-image qr-image--empty">暂无团单二维码</view>
        <view class="qr-label">点一下放大，长按分享</view>
      </view>
      <view class="share-entry" wx:if="{{canManageGroupOrder}}">
        <view class="share-path">{{customerEntryPath || '客户入口加载中'}}</view>
        <view class="share-actions">
          <t-button size="small" theme="primary" open-type="share" disabled="{{!groupOrderId}}">分享给客户</t-button>
          <t-button size="small" theme="default" bindtap="onCopyCustomerEntry" disabled="{{!groupOrderId}}">复制入口</t-button>
          <t-button size="small" theme="light" bindtap="ensureShareQr" loading="{{qrLoading}}" disabled="{{!groupOrderId}}">{{groupOrder.qrCodeUrl ? '重新生成二维码' : '生成二维码'}}</t-button>
        </view>
      </view>
    </view>

    <!-- 管理者视图：全团应收/已收/人数统计（A6/B1：客户不可见） -->
    <view wx:if="{{canManageGroupOrder}}" class="statistics-card">
      <view class="stat-item">
        <text class="stat-label">应收总金额</text>
        <text class="stat-value">￥{{ utils.formatNumber(groupOrder.totalReceivable)}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">已收总金额</text>
        <text class="stat-value">￥{{ utils.formatNumber(groupOrder.totalReceived)}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">下单人数</text>
        <text class="stat-value">{{ utils.formatNumber(groupOrder.totalCustomers)}}人</text>
      </view>
    </view>

    <!-- 管理者视图：全团客户订单列表（A6/B1：客户不可见他人订单） -->
    <block wx:if="{{canManageGroupOrder}}">
      <view class="section-title">客户订单</view>
      <view wx:for="{{groupOrder.memberOrderList}}" wx:key="id" wx:for-item="memberOrder"
        class="order-card" bindtap="onShowOrderDetails" data-index="{{index}}" hover-class="card-hover">

        <view class="order-header">
          <text class="order-no">订单编号：#{{memberOrder.id}}</text>
          <text
            class="order-status {{utils.memberOrderHelper.getStatusClass(memberOrder.status)}}">{{utils.memberOrderHelper.getStatusText(memberOrder.status)}}</text>
        </view>

        <view class="order-body">
          <view class="info-item">
            <text class="label">客户：</text>
            <text class="value">{{memberOrder.customerName || memberOrder.customerUserId || memberOrder.userId}}</text>
          </view>
          <view class="info-item">
            <text class="label">商品数量：</text>
            <text class="value">{{memberOrder.itemCount || memberOrder.productList.length || 0}} 件</text>
          </view>
          <view class="info-item">
            <text class="label">应付总额：</text>
            <text class="value price">￥{{memberOrder.totalPrice}}</text>
          </view>
          <view class="action-section" wx:if="{{memberOrder.status === 1}}">
            <t-button theme="primary" size="small" block variant="outline" catchtap="onConfirmPayment"
              data-id="{{memberOrder.id}}">确认已到账</t-button>
          </view>
          <view class="action-section" wx:if="{{memberOrder.status !== 2 && memberOrder.status !== 3}}">
            <t-button theme="danger" size="small" block variant="outline" catchtap="onCancelOrder"
              data-id="{{memberOrder.id}}">取消订单</t-button>
          </view>
        </view>
      </view>

      <view wx:if="{{groupOrder.memberOrderList.length === 0}}" class="empty-msg">
        当前团单暂无客户订单
      </view>
    </block>

    <!-- 客户视图：本团在售商品（可收合）+ 只显自己那一单（A6/B1） -->
    <block wx:if="{{!canManageGroupOrder}}">
      <view class="section-title onsale-title" bindtap="toggleOnSaleProducts">
        <text>本团在售商品</text>
        <text class="onsale-toggle">{{showOnSaleProducts ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showOnSaleProducts}}" class="onsale-list">
        <view wx:for="{{onSaleProducts}}" wx:key="id" class="onsale-item">
          <view class="onsale-item__main">
            <text class="onsale-item__title">{{item.title}}</text>
            <text wx:if="{{item.description}}" class="onsale-item__desc">{{item.description}}</text>
          </view>
          <view class="onsale-item__tiers">
            <text wx:for="{{item.priceTiers}}" wx:for-item="tier" wx:key="minQuantity" class="onsale-item__tier">{{tier.label}}</text>
            <text wx:if="{{item.priceTiers.length === 0}}" class="onsale-item__tier">{{item.priceDisplay}}</text>
          </view>
        </view>
        <view wx:if="{{onSaleProducts.length === 0}}" class="empty-msg">本团暂无在售商品</view>
      </view>

      <view class="section-title">我的订单</view>
      <view wx:for="{{groupOrder.memberOrderList}}" wx:key="id" wx:for-item="memberOrder" class="order-card">
        <view class="order-header">
          <text class="order-no">订单编号：#{{memberOrder.id}}</text>
          <text
            class="order-status {{utils.memberOrderHelper.getStatusClass(memberOrder.status)}}">{{utils.memberOrderHelper.getStatusText(memberOrder.status)}}</text>
        </view>
        <view class="order-body">
          <view class="info-item">
            <text class="label">商品数量：</text>
            <text class="value">{{memberOrder.itemCount || memberOrder.productList.length || 0}} 件</text>
          </view>
          <view class="info-item">
            <text class="label">应付总额：</text>
            <text class="value price">￥{{memberOrder.totalPrice}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{groupOrder.memberOrderList.length === 0}}" class="empty-msg">
        你在本团暂无订单
      </view>
    </block>

    <view wx:if="{{canManageGroupOrder}}" class="footer-action-bar">
      <t-button theme="default" class="btn-secondary" size="large" block bind:tap="onEditGroupOrder"
        disabled="{{!groupOrderId}}">
        编辑团单
      </t-button>
      <t-button theme="primary" class="btn-primary" size="large" block bind:tap="onExportReport"
        disabled="{{groupOrder.memberOrderList.length === 0 }}">
        导出报表
      </t-button>
      <t-button theme="default" class="btn-secondary" size="large" block bind:tap="onManageProducts"
        disabled="{{!groupOrderId}}">
        本团商品
      </t-button>
      <t-button theme="default" class="btn-secondary" size="large" block bind:tap="onCustomerOrderEntry"
        disabled="{{!groupOrderId}}">
        客户下单入口
      </t-button>
    </view>
  </page-state>
</view>

<t-popup wx:if="{{canManageGroupOrder}}" visible="{{showDetails}}" bind:visible-change="onCloseDetails" placement="center">
  <view class="details-popup">
    <view class="popup-header">订单明细 (#{{selectedMemberOrder.id}})</view>

    <scroll-view scroll-y class="details-content" wx:if="{{selectedMemberOrder && selectedMemberOrder.productList}}">
      <view class="item-row" wx:for="{{selectedMemberOrder.productList}}" wx:key="productId">
        <view class="item-main">
          <text wx:if="{{item.title}}" class="item-name">{{item.title}}</text>
          <text wx:else class="item-name">商品资料</text>
          <text class="item-spec">数量: {{item.amount}}</text>
        </view>
        <view class="item-price-info">
          <text class="item-subtotal">￥{{utils.formatNumber(item.totalPrice)}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="popup-footer">
      <view class="total-bar">
        <text>应付总额</text>
        <text class="total-price">￥{{utils.formatNumber(selectedMemberOrder.totalPrice)}}</text>
      </view>
      <t-button theme="primary" block size="large" bindtap="onCloseDetails">关闭</t-button>
    </view>
  </view>
</t-popup>

<view wx:if="{{showConfirmDialog}}" class="action-mask" catchtap="handleDialogClose">
  <view class="action-panel" catchtap="stopPanelTap">
    <view class="action-panel__header">
      <text class="action-panel__title">确认收款</text>
      <text class="action-panel__close" bindtap="handleDialogClose">关闭</text>
    </view>
    <view class="action-form">
      <view class="action-field">
        <text class="action-label">实收金额</text>
        <input class="action-input" type="digit" placeholder="请输入实际到账金额" value="{{confirmForm.confirmedAmount}}" data-field="confirmedAmount" bindinput="onConfirmInput" />
      </view>
      <view class="action-field">
        <text class="action-label">确认备注</text>
        <textarea class="action-textarea" placeholder="例：已核对微信到账，少付/多付说明" value="{{confirmForm.confirmRemark}}" data-field="confirmRemark" bindinput="onConfirmInput" />
      </view>
    </view>
    <view class="action-panel__footer">
      <t-button size="large" variant="outline" bindtap="handleDialogClose">取消</t-button>
      <t-button size="large" theme="primary" bindtap="handleDialogConfirm">确认收款</t-button>
    </view>
  </view>
</view>

<view wx:if="{{showCancelDialog}}" class="action-mask" catchtap="handleCancelDialogClose">
  <view class="action-panel" catchtap="stopPanelTap">
    <view class="action-panel__header">
      <text class="action-panel__title">取消订单</text>
      <text class="action-panel__close" bindtap="handleCancelDialogClose">关闭</text>
    </view>
    <view class="action-form">
      <view class="action-field">
        <text class="action-label">取消原因</text>
        <textarea class="action-textarea" placeholder="选填，方便持续追踪" value="{{cancelForm.cancelRemark}}" data-field="cancelRemark" bindinput="onCancelInput" />
      </view>
    </view>
    <view class="action-panel__footer">
      <t-button size="large" variant="outline" bindtap="handleCancelDialogClose">返回</t-button>
      <t-button size="large" theme="danger" bindtap="handleCancelDialogConfirm">取消订单</t-button>
    </view>
  </view>
</view>
