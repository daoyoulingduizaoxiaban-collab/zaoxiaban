<nav nav-type="productManagement" titleText="{{titleText}}" />
<view class="container">
  <view class="filter-section">
    <view class="search-input-wrap">
      <icon type="search" size="16"></icon>
      <input
        class="search-input"
        placeholder="搜索商品标题或描述"
        value="{{searchKeyword}}"
        bindinput="onInputKeyword"
      />
      <text class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">×</text>
    </view>

    <view class="price-filter">
      <text class="filter-label">起售价区间:</text>
      <input type="number" placeholder="最低" bindinput="onMinPriceInput" />
      <text class="separator">-</text>
      <input type="number" placeholder="最高" bindinput="onMaxPriceInput" />
    </view>

    <button class="search-confirm-btn" bindtap="executeSearch">搜索</button>
  </view>

  <scroll-view scroll-y class="product-list">
    <view class="empty-tip" wx:if="{{isLoading}}">正在加载商品</view>
    <view class="empty-tip" wx:elif="{{pageErrorText}}">{{pageErrorText}}</view>
    <block wx:else wx:for="{{filteredList}}" wx:key="id">
      <view class="product-card" bindtap="openDetail" data-id="{{item.id}}">
        <image class="cover-image" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError"></image>
        <view class="content-area">
          <view class="header">
            <text class="title">{{item.title}}</text>
            <text class="id-tag">ID: {{item.id}}</text>
          </view>
          <text class="description">{{item.description}}</text>
          <text class="description">{{item.sourceNote}}</text>
          <text class="description">{{item.priceDisplay}}</text>
          <view class="price-settings">
            <view class="setting-item" wx:for="{{item.priceSetting}}" wx:for-item="price" wx:key="minQuantity">
              <text class="q-range">满 {{price.minQuantity}} 件:</text>
              <text class="u-price">￥{{price.unitPrice}}/件</text>
              <text class="t-price" wx:if="{{price.totalPrice}}">(共 ¥{{price.totalPrice}})</text>
              <text class="p-desc" wx:if="{{price.description}}">{{price.description}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view class="empty-tip" wx:if="{{!isLoading && !pageErrorText && filteredList.length === 0}}">找不到符合条件的商品</view>
  </scroll-view>

  <view wx:if="{{detailVisible}}" class="detail-mask" catchtap="closeDetail">
    <view class="detail-panel" catchtap="noop">
      <image class="detail-img" src="{{selectedProduct.coverUrl}}" mode="aspectFill" binderror="onDetailImageError" />
      <view class="detail-content">
        <view class="detail-title">{{selectedProduct.title}}</view>
        <view class="detail-section">
          <text class="detail-label">商品描述</text>
          <text class="detail-text">{{selectedProduct.description || '暂无描述'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">价格规则</text>
          <block wx:if="{{selectedPriceRules.length}}">
            <view class="price-rule" wx:for="{{selectedPriceRules}}" wx:key="minQuantity">
              <text>{{item.minQuantity}} 件起</text>
              <text>￥{{item.unitPrice}}</text>
              <text wx:if="{{item.description}}" class="price-rule__note">{{item.description}}</text>
            </view>
          </block>
          <text wx:else class="detail-text">未设置</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">供应来源</text>
          <text class="detail-text">{{selectedProduct.sourceNote || '暂无'}}</text>
        </view>
      </view>
      <button class="detail-close" bindtap="closeDetail">知道了</button>
    </view>
  </view>
</view>
