<sub-nav title="{{ pageTitle }}" fallback-url="/pages/productManagement/index" />

<view class="access-card" wx:if="{{accessDenied}}">
  <view class="access-title">{{accessStateText || '当前账号不能新增商品'}}</view>
  <view class="access-desc">请使用已通过审核且具备商品管理权限的账号。</view>
</view>

<page-state
  wx:else
  state="{{pageState}}"
  loading-text="{{isEdit ? '正在加载商品资料' : '正在准备商品表单'}}"
  error-text="{{loadErrorText}}"
  bind:retry="onRetry"
>
<view class="page-container">
  <view class="content-scroll">
    <view class="card">
      <view class="form-group">
        <text class="label">商品名称 <text class="required">*</text></text>
        <input class="input-box" placeholder="例如：黄山伴手礼礼盒" data-field="title" value="{{currentProduct.title}}" bindinput="onProductInput" />
      </view>

      <view class="form-group">
        <text class="label">商品描述 <text class="required">*</text></text>
        <textarea class="textarea-box" placeholder="请输入商品介绍、规格、交付说明..." data-field="description" value="{{currentProduct.description}}" bindinput="onProductInput" disable-default-padding />
      </view>

      <view class="form-group">
        <text class="label">供应来源或备注 <text class="required">*</text></text>
        <input class="input-box" placeholder="例如：杭州伴手礼供应商 / 团主自建商品" data-field="sourceNote" value="{{currentProduct.sourceNote}}" bindinput="onProductInput" />
      </view>

      <view class="form-group">
        <text class="label">商品状态</text>
        <button class="btn-status" bindtap="toggleStatus">{{currentProduct.status === 2 ? '已上架，点击下架' : '已下架，点击上架'}}</button>
      </view>

      <view class="form-group">
        <text class="label">商品图片 ({{currentProduct.pictureUrls.length}}/3)</text>
        <view class="image-tip">{{imageModeTip}}</view>
        <view class="image-grid">
          <block wx:for="{{currentProduct.pictureUrls}}" wx:key="*this">
            <view class="img-wrap">
              <image src="{{item}}" mode="aspectFill" class="uploaded-img"></image>
              <view class="btn-remove" catchtap="removeImage" data-index="{{index}}">×</view>
            </view>
          </block>
          <view class="upload-btn" bindtap="chooseImage" wx:if="{{currentProduct.pictureUrls.length < 3}}">
            <text class="plus-icon">{{isChoosingImage ? '...' : '+'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-header">
        <text class="label">价格设置 (至少一组) <text class="required">*</text></text>
      </view>

      <view class="price-list" wx:if="{{currentProduct.priceSetting.length > 0}}">
        <view class="price-item" wx:for="{{currentProduct.priceSetting}}" wx:key="index">
          <view class="p-info">
            <text class="p-qty">满 {{item.minQuantity}} 件{{index === 0 ? '（基准价）' : ''}}</text>
            <text class="p-val">¥{{item.unitPrice}}</text>
            <text class="p-desc" wx:if="{{item.description}}">({{item.description}})</text>
          </view>
          <view class="p-del" bindtap="removePriceRule" data-index="{{index}}">{{index === 0 ? '重填' : '删除'}}</view>
        </view>
      </view>

      <view class="price-input-row">
        <view class="col-small">
          <text class="sub-label">起订量</text>
          <input type="number" class="input-box small" placeholder="1" value="{{currentProduct.priceSetting.length === 0 ? 1 : tempPriceSetting.minQuantity}}" disabled="{{currentProduct.priceSetting.length === 0}}" data-field="minQuantity" bindinput="onPriceInput"/>
        </view>
        
        <view class="col-small">
          <text class="sub-label">单价(¥)</text>
          <input type="digit" class="input-box small" placeholder="0" value="{{tempPriceSetting.unitPrice}}" data-field="unitPrice" bindinput="onPriceInput"/>
        </view>
        
        <view class="col-large">
          <text class="sub-label">说明(选填)</text>
          <input class="input-box small" placeholder="如:团单价" value="{{tempPriceSetting.description}}" data-field="description" bindinput="onPriceInput"/>
        </view>
        
        <view class="col-btn">
          <view class="btn-add-rule" bindtap="addPriceRule">+</view>
        </view>
      </view>

      <button class="btn-save-product" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="addProductToList">保存商品</button>
    </view>
  </view>

  <view class="footer-bar">
    <button class="btn-submit" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="addProductToList">保存商品</button>
  </view>
</view>
</page-state>
