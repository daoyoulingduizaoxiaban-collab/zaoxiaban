<wxs src="../../../utils/utils.wxs" module="utils" />
<sub-nav title="{{ pageTitle }}" />

<view class="edit-container">
  <t-cell-group theme="card">
    <t-input label="行程名稱" placeholder="請輸入1~20個字元" value="{{ itinerary.title }}" />
    <t-input label="行程狀態" value="{{ itinerary.statusText }}" />
    <t-input label="描述" value="{{ itinerary.description }}" />
    <!-- <t-cell title="出發日期" note="{{ itinerary.date || '請選擇' }}" arrow bind:tap="showDatePicker" /> -->
    <view class="qr-container" bindtap="previewQR">
      <image class="qr-image" src="{{ itinerary.qrCodeUrl }}" mode="aspectFit" binderror="onImageError"
        show-menu-by-longpress />
      <view class="qr-label">點一下放大</view>
    </view>
  </t-cell-group>

  <view class="statistics-card">
    <view class="stat-item">
      <text class="stat-label">應收總金額</text>
      <text class="stat-value">￥{{ utils.formatNumber(itinerary.totalReceivable)}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">已收總金額</text>
      <text class="stat-value">￥{{ utils.formatNumber(itinerary.totalReceived)}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">總下單人數</text>
      <text class="stat-value">{{ utils.formatNumber(itinerary.totalCustomers)}}人</text>
    </view>
  </view>
  <!-- TODO iterator錯誤 -->
  <view class="section-title">客戶訂單</view>

  <block wx:for="{{itinerary.customerOrderList}}" wx:key="id" wx:for-item="customerDetail">
    <view class="order-card" bindtap="onShowOrderDetails" data-index="{{index}}" hover-class="card-hover">

      <view class="order-header">
        <text class="order-no">訂單編號：#{{customerDetail.id}}</text>
        <text class="order-status {{customerDetail.customerOrdertatus === 1 ? 'status-done' : 'status-pending'}}">
          {{customerDetail.customerOrdertatus === 1 ? '已完成' : '待付款'}}
        </text>
      </view>

      <view class="order-body">
        <view class="info-item">
          <text class="label">客戶 ID：</text>
          <text class="value">{{customerDetail.customerId}}</text>
        </view>
        <view class="info-item">
          <text class="label">商品數量：</text>
          <text class="value">{{customerDetail.length || 0}} 件</text>
        </view>
        <view class="info-item">
          <text class="label">應付總額：</text>
          <text class="value price">￥{{customerDetail.totalAmount}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{itinerary.customerOrder.length === 0}}" class="empty-msg">
    目前尚無訂購資料
  </view>

  <view class="footer-action-bar">
    <t-button theme="primary" size="large" block bind:tap="onExportReport"
      disabled="{{itinerary.customerOrder.length === 0 }}">
      匯出報表
    </t-button>
  </view>
</view>

<t-popup visible="{{showDetails}}" bind:visible-change="onCloseDetails" placement="center">
  <view class="details-popup">
    <view class="popup-header">訂單明細 (#{{selectedOrder.id}})</view>

    <scroll-view scroll-y class="details-content">
      <view class="item-row" wx:for="{{selectedOrder.customerGoodsList}}" wx:key="goodsId">
        <view class="item-main">
          <text class="item-name">商品 ID: {{item.goodsId}}</text>
          <text class="item-spec">數量: {{item.amount}}</text>
        </view>
        <view class="item-price-info">
          <text class="item-subtotal">￥{{utils.formatNumber(item.totalPrice)}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="popup-footer">
      <view class="total-bar">
        <text>應付總額</text>
        <text class="total-price">￥{{utils.formatNumber(selectedOrder.totalPrice)}}</text>
      </view>
      <t-button theme="primary" block size="large" bindtap="onCloseDetails">關閉</t-button>
    </view>
  </view>
</t-popup>