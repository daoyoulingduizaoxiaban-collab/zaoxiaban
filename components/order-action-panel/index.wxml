<view wx:if="{{visible}}" class="action-mask" catchtap="onClose">
  <view class="action-panel" catchtap="stopTap">
    <view class="action-panel__header">
      <text class="action-panel__title">{{title}}</text>
      <text class="action-panel__close" bind:tap="onClose">关闭</text>
    </view>

    <view wx:if="{{actionType === 'declarePaid'}}" class="action-form">
      <view class="action-field">
        <text class="action-label">付款金额</text>
        <input class="action-input" type="digit" placeholder="请输入实际付款金额" value="{{actionForm.declaredAmount}}" data-field="declaredAmount" bindinput="onInput" />
      </view>
      <view class="action-field">
        <text class="action-label">付款方式</text>
        <input class="action-input" placeholder="微信/支付宝/现金/转账" value="{{actionForm.paymentMethod}}" data-field="paymentMethod" bindinput="onInput" />
      </view>
      <view class="action-field">
        <text class="action-label">付款备注</text>
        <textarea class="action-textarea" placeholder="填写流水尾号、代付人或其他核对信息" value="{{actionForm.paymentRemark}}" data-field="paymentRemark" bindinput="onInput" />
      </view>
      <view class="action-proof">
        <view class="action-proof__header">
          <text class="action-label">付款凭证</text>
          <button size="mini" plain bindtap="chooseProof" disabled="{{submitting}}">上传</button>
        </view>
        <view class="action-proof__list" wx:if="{{actionForm.paymentProofUrls.length}}">
          <view class="action-proof__item" wx:for="{{actionForm.paymentProofUrls}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" bindtap="previewProof" data-index="{{index}}" />
            <text bindtap="removeProof" data-index="{{index}}">移除</text>
          </view>
        </view>
      </view>
      <view class="action-hint">请填写付款金额、付款方式；可上传付款凭证，方便团主核对收款。</view>
    </view>

    <view wx:elif="{{actionType === 'confirmPayment'}}" class="action-form">
      <view class="action-field">
        <text class="action-label">实收金额</text>
        <input class="action-input" type="digit" placeholder="请输入实际到账金额" value="{{actionForm.confirmedAmount}}" data-field="confirmedAmount" bindinput="onInput" />
      </view>
      <view class="action-field">
        <text class="action-label">确认备注</text>
        <textarea class="action-textarea" placeholder="例：已核对微信到账，少付/多付说明" value="{{actionForm.confirmRemark}}" data-field="confirmRemark" bindinput="onInput" />
      </view>
    </view>

    <view wx:else class="action-form">
      <view class="action-field">
        <text class="action-label">取消原因</text>
        <textarea class="action-textarea" placeholder="选填，方便持续追踪" value="{{actionForm.cancelRemark}}" data-field="cancelRemark" bindinput="onInput" />
      </view>
    </view>

    <view class="action-panel__footer">
      <t-button size="large" variant="outline" bind:tap="onClose" disabled="{{submitting}}">取消</t-button>
      <t-button size="large" theme="primary" loading="{{submitting}}" bind:tap="onSubmit">{{submitText}}</t-button>
    </view>
  </view>
</view>
