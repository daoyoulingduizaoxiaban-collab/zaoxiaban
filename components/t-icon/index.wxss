.local-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  color: inherit;
  line-height: 1;
  vertical-align: middle;
}

.local-icon__shape,
.local-icon__shape::before,
.local-icon__shape::after {
  box-sizing: border-box;
}

.local-icon__shape {
  position: relative;
  width: 72%;
  height: 72%;
  color: currentColor;
}

.local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 6px;
}

.local-icon__shape::before {
  content: "";
  position: absolute;
  left: 18%;
  top: 18%;
  width: 64%;
  height: 64%;
  border: 2px solid currentColor;
  border-left: 0;
  border-bottom: 0;
  border-radius: 3px;
}

.local-icon--home .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 4px 4px 6px 6px;
  transform: translateY(12%);
}

.local-icon--home .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -18%;
  width: 62%;
  height: 62%;
  border-left: 2px solid currentColor;
  border-top: 2px solid currentColor;
  border-radius: 2px 0 0 0;
  background: transparent;
  transform: translateX(-50%) rotate(45deg);
}

.local-icon--home .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 72%;
  width: 24%;
  height: 34%;
  border: 2px solid currentColor;
  border-bottom: 0;
  border-radius: 3px 3px 0 0;
  background: transparent;
  transform: translate(-50%, -50%);
}

.local-icon--none .local-icon__shape,
.local-icon--success .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 999px;
}

.local-icon--none .local-icon__shape::before,
.local-icon--success .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.local-icon--success .local-icon__shape::before {
  left: 52%;
  top: 48%;
  width: 54%;
  height: 32%;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  border-radius: 0;
  background: transparent;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.local-icon--add .local-icon__shape::before,
.local-icon--add .local-icon__shape::after,
.local-icon--action .local-icon__shape::before,
.local-icon--action .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 78%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.local-icon--add .local-icon__shape,
.local-icon--action .local-icon__shape,
.local-icon--check .local-icon__shape,
.local-icon--edit .local-icon__shape,
.local-icon--search .local-icon__shape,
.local-icon--user .local-icon__shape,
.local-icon--usergroup .local-icon__shape,
.local-icon--user-setting .local-icon__shape,
.local-icon--bulletpoint .local-icon__shape,
.local-icon--root-list .local-icon__shape,
.local-icon--view-list .local-icon__shape,
.local-icon--app .local-icon__shape,
.local-icon--upload .local-icon__shape,
.local-icon--chat .local-icon__shape,
.local-icon--data-display .local-icon__shape {
  border: 0;
}

.local-icon--add .local-icon__shape::after,
.local-icon--action .local-icon__shape::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.local-icon--check .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 20%;
  top: 48%;
  width: 58%;
  height: 32%;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(-45deg);
}

.local-icon--close-circle-filled .local-icon__shape,
.local-icon--info-circle .local-icon__shape,
.local-icon--delete .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 999px;
}

.local-icon--close-circle-filled .local-icon__shape {
  background: currentColor;
}

.local-icon--info-circle .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 22%;
  width: 2px;
  height: 2px;
  border-radius: 999px;
  background: currentColor;
  transform: translateX(-50%);
  box-shadow: 0 0.24em 0 currentColor, 0 0.36em 0 currentColor, 0 0.48em 0 currentColor;
}

.local-icon--info-circle .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 46%;
  width: 2px;
  height: 32%;
  border-radius: 99px;
  background: currentColor;
  transform: translateX(-50%);
}

.local-icon--close-circle-filled .local-icon__shape::before,
.local-icon--close-circle-filled .local-icon__shape::after,
.local-icon--delete .local-icon__shape::before,
.local-icon--delete .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 58%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.local-icon--close-circle-filled .local-icon__shape::before,
.local-icon--close-circle-filled .local-icon__shape::after {
  background: #fff;
}

.local-icon--close-circle-filled .local-icon__shape::after,
.local-icon--delete .local-icon__shape::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.local-icon--search .local-icon__shape {
  width: 62%;
  height: 62%;
  border: 2px solid currentColor;
  border-radius: 999px;
  transform: translate(-8%, -8%);
}

.local-icon--search .local-icon__shape::after {
  content: "";
  position: absolute;
  right: -30%;
  bottom: -22%;
  width: 42%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  transform: rotate(45deg);
}

.local-icon--edit .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 20%;
  top: 48%;
  width: 64%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  transform: rotate(-45deg);
}

.local-icon--edit .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 16%;
  bottom: 14%;
  width: 68%;
  height: 2px;
  background: currentColor;
}

.local-icon--user .local-icon__shape::before,
.local-icon--usergroup .local-icon__shape::before,
.local-icon--user-setting .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 8%;
  width: 36%;
  height: 36%;
  border: 2px solid currentColor;
  border-radius: 999px;
  transform: translateX(-50%);
}

.local-icon--user .local-icon__shape::after,
.local-icon--usergroup .local-icon__shape::after,
.local-icon--user-setting .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 17%;
  bottom: 8%;
  width: 66%;
  height: 38%;
  border: 2px solid currentColor;
  border-radius: 999px 999px 20% 20%;
}

.local-icon--usergroup .local-icon__shape {
  transform: scale(0.88);
  box-shadow: -0.28em 0.2em 0 -0.12em currentColor, 0.28em 0.2em 0 -0.12em currentColor;
}

.local-icon--shop .local-icon__shape {
  border: 2px solid currentColor;
  border-top-width: 0;
  border-radius: 0 0 4px 4px;
}

.local-icon--shop .local-icon__shape::before {
  content: "";
  position: absolute;
  left: -8%;
  top: -28%;
  width: 116%;
  height: 34%;
  border: 2px solid currentColor;
  border-radius: 4px 4px 8px 8px;
}

.local-icon--bulletpoint .local-icon__shape,
.local-icon--root-list .local-icon__shape,
.local-icon--view-list .local-icon__shape {
  height: 64%;
}

.local-icon--bulletpoint .local-icon__shape::before,
.local-icon--root-list .local-icon__shape::before,
.local-icon--view-list .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  width: 100%;
  height: 2px;
  background: currentColor;
  box-shadow: 0 0.28em 0 currentColor, 0 0.56em 0 currentColor;
}

.local-icon--app .local-icon__shape {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 16%;
}

.local-icon--app .local-icon__shape::before,
.local-icon--app .local-icon__shape::after {
  content: "";
  border: 2px solid currentColor;
  border-radius: 4px;
}

.local-icon--upload .local-icon__shape {
  border-bottom: 2px solid currentColor;
}

.local-icon--upload .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 12%;
  width: 2px;
  height: 58%;
  background: currentColor;
  transform: translateX(-50%);
}

.local-icon--upload .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 32%;
  top: 12%;
  width: 34%;
  height: 34%;
  border-left: 2px solid currentColor;
  border-top: 2px solid currentColor;
  transform: rotate(45deg);
}

.local-icon--chat .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 8px;
}

.local-icon--chat .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 18%;
  bottom: -20%;
  width: 28%;
  height: 28%;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  background: transparent;
  transform: rotate(-18deg);
}

.local-icon--data-display .local-icon__shape {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12%;
}

.local-icon--data-display .local-icon__shape::before,
.local-icon--data-display .local-icon__shape::after {
  content: "";
  width: 24%;
  background: currentColor;
  border-radius: 99px 99px 0 0;
}

.local-icon--data-display .local-icon__shape::before {
  height: 55%;
  box-shadow: 0.32em -0.22em 0 currentColor;
}

.local-icon--data-display .local-icon__shape::after {
  height: 82%;
}

.local-icon--setting .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 999px;
}

.local-icon--setting .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34%;
  height: 34%;
  border: 2px solid currentColor;
  border-radius: 999px;
  transform: translate(-50%, -50%);
}

.local-icon--setting .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -22%;
  width: 2px;
  height: 144%;
  background: currentColor;
  transform: translateX(-50%);
  box-shadow: 0.26em 0 0 currentColor, -0.26em 0 0 currentColor;
}

.local-icon--user-setting .local-icon__shape {
  transform: scale(0.86);
}

.local-icon--user-setting.local-icon::after {
  content: "";
  position: absolute;
  right: 8%;
  bottom: 8%;
  width: 28%;
  height: 28%;
  border: 2px solid currentColor;
  border-radius: 999px;
  background: transparent;
}

.local-icon--server .local-icon__shape,
.local-icon--cloud .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 6px;
}

.local-icon--server .local-icon__shape::before,
.local-icon--server .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 16%;
  width: 68%;
  height: 2px;
  background: currentColor;
}

.local-icon--server .local-icon__shape::before {
  top: 34%;
}

.local-icon--server .local-icon__shape::after {
  top: 62%;
}

.local-icon--cloud .local-icon__shape {
  border-radius: 999px 999px 8px 8px;
  transform: translateY(12%);
}

.local-icon--cloud .local-icon__shape::before,
.local-icon--cloud .local-icon__shape::after {
  content: "";
  position: absolute;
  border: 2px solid currentColor;
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
  background: transparent;
}

.local-icon--cloud .local-icon__shape::before {
  left: 6%;
  top: -28%;
  width: 44%;
  height: 46%;
}

.local-icon--cloud .local-icon__shape::after {
  right: 6%;
  top: -38%;
  width: 52%;
  height: 58%;
}

.local-icon--secured .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 8px 8px 14px 14px;
}

.local-icon--secured .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 18%;
  top: -36%;
  width: 64%;
  height: 58%;
  border: 2px solid currentColor;
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
}

.local-icon--secured .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 30%;
  top: 44%;
  width: 40%;
  height: 22%;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(-45deg);
}

.local-icon--discount .local-icon__shape,
.local-icon--location .local-icon__shape {
  border: 2px solid currentColor;
}

.local-icon--discount .local-icon__shape {
  border-radius: 6px;
  transform: rotate(-10deg);
}

.local-icon--discount .local-icon__shape::before,
.local-icon--discount .local-icon__shape::after {
  content: "";
  position: absolute;
  border-radius: 999px;
  background: currentColor;
}

.local-icon--discount .local-icon__shape::before {
  left: 22%;
  top: 22%;
  width: 10%;
  height: 10%;
}

.local-icon--discount .local-icon__shape::after {
  left: 24%;
  top: 50%;
  width: 54%;
  height: 2px;
  transform: rotate(-38deg);
}

.local-icon--location .local-icon__shape {
  border-radius: 999px 999px 999px 0;
  transform: rotate(-45deg) scale(0.88);
}

.local-icon--location .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34%;
  height: 34%;
  border: 2px solid currentColor;
  border-radius: 999px;
  transform: translate(-50%, -50%);
}

.local-icon--order .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 6px;
}

.local-icon--order .local-icon__shape::before {
  content: "";
  position: absolute;
  left: 18%;
  top: 26%;
  width: 64%;
  height: 2px;
  border-radius: 99px;
  background: currentColor;
  box-shadow: 0 0.26em 0 currentColor, 0 0.52em 0 currentColor;
}

.local-icon--time .local-icon__shape {
  border: 2px solid currentColor;
  border-radius: 999px;
}

.local-icon--time .local-icon__shape::before,
.local-icon--time .local-icon__shape::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2px;
  border-radius: 99px;
  background: currentColor;
  transform-origin: 50% 0;
}

.local-icon--time .local-icon__shape::before {
  height: 30%;
  transform: translate(-50%, -2%) rotate(0deg);
}

.local-icon--time .local-icon__shape::after {
  height: 24%;
  transform: translate(-50%, -2%) rotate(120deg);
}
